+
+/**
+ * CleanTV/VGS: Kho Danh ngôn, Ca dao, Tục ngữ và Lời hay ý đẹp cho phòng khách gia đình.
+ * Chọn lọc từ ca dao tục ngữ Việt Nam, lời dạy của Bác Hồ, danh nhân văn hóa thế giới.
+ * Chạy 100% offline, không tốn tài nguyên mạng hay RAM của TV.
+ */
+public final class QuotesProvider {
+
+    private QuotesProvider() {
+    }
+
+    public static class QuoteItem {
+        public final String text;
+        public final String author;
+
+        public QuoteItem(String text, String author) {
+            this.text = text;
+            this.author = author;
+        }
+
+        public String getFormatted() {
