+package com.gathin.tvhome;
+
+import android.service.notification.NotificationListenerService;
+
+/**
+ * CleanTV/VGS: does nothing itself. Being an allowed notification listener is what lets the launcher read the active
+ * media sessions (MediaSessionManager.getActiveSessions) for the Now playing button. CleanTV allows it over ADB with
+ * "cmd notification allow_listener"; without it the button simply never shows.
+ */
+public class NowPlayingListener extends NotificationListenerService {
+}
