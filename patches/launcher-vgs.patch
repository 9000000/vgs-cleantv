+        }, OPEN_DELAY_MS);
+    }
+
+    /** Settings.Global key CleanTV reads in its Home diagnosis (3.5.5). */
+    static final String NOTE_KEY = "cleantv_boot";
+
+    /**
+     * CleanTV/VGS 3.5.5: logcat on a TCL 43P618 had rotated the boot lines away nine minutes after boot (Võ Thái,
+     * 27/10/2026), so what ran at boot is also kept in Settings.Global, which CleanTV can read at any time:
+     * "boot 7: b12 h14 o16 s20" = boot count, then event + seconds since boot (b BOOT_COMPLETED, q QUICKBOOT,
+     * n notification listener bound, h helper connected, o Home opened, r open refused, s stock home seen, x helper turned back on).
+     * Needs WRITE_SECURE_SETTINGS, which CleanTV grants; without it nothing is noted.
+     */
+    static void note(Context context, String event) {
+        if (context.checkSelfPermission(Manifest.permission.WRITE_SECURE_SETTINGS) != PackageManager.PERMISSION_GRANTED) return;
+        try {
+            android.content.ContentResolver cr = context.getContentResolver();
+            String head = "boot " + Settings.Global.getInt(cr, Settings.Global.BOOT_COUNT, -1) + ":";
+            String old = Settings.Global.getString(cr, NOTE_KEY);
+            String line = old != null && old.startsWith(head) ? old : head;
+            if (line.length() > 200) return;
+            Settings.Global.putString(cr, NOTE_KEY, line + " " + event + android.os.SystemClock.elapsedRealtime() / 1000);
+        } catch (RuntimeException ignored) {
+        }
+    }
+
+    /** HomeKeyService back on the enabled list (and accessibility on), as CleanTV turned it on. */
+    static void enableHelper(Context context) {
+        if (context.checkSelfPermission(Manifest.permission.WRITE_SECURE_SETTINGS) != PackageManager.PERMISSION_GRANTED) {
+            Log.w(TAG, "helper: no WRITE_SECURE_SETTINGS");
+            return;
+        }
+        try {
+            String me = new ComponentName(context, HomeKeyService.class).flattenToShortString();
+            String list = Settings.Secure.getString(context.getContentResolver(), Settings.Secure.ENABLED_ACCESSIBILITY_SERVICES);
+            if (list == null || list.equals("null")) list = "";
+            boolean on = false;
+            for (String entry : list.split(":")) {
+                ComponentName name = ComponentName.unflattenFromString(entry);
+                if (name != null && name.flattenToShortString().equals(me)) on = true;
+            }
+            if (!on) Settings.Secure.putString(context.getContentResolver(), Settings.Secure.ENABLED_ACCESSIBILITY_SERVICES,
