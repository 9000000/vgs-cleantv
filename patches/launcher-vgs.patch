@@ -0,0 +1,182 @@
+"""tools/privacy.py --write looks at the file it was given before it asks the TV anything.
+
+The check that the file is new ran only after connect() and the whole audit, which is up to 25
+`dumpsys package` calls, slow on old firmware, and as many `appops` calls. Then --write refused a
+file that was there all along, and a name in a folder that does not exist ended in a
+FileNotFoundError traceback. Both are now refused first, saying that nothing was asked of the TV.
+The check when writing stays, for a file that appears during the audit.
+
+With --include-low, the list also said nothing about the name matches the audit's probe cap left
+out, though the report counts them, so it looked complete. The terminal and the list header now say
+how many were left out.
+
+tools/tv.py is the fake from test_privacy_audit.py, so the real audit runs and only ADB is simulated.
+An unreachable fake TV is how a test sees that the TV was not asked: connecting to it fails.
+
+Run from the repository root: python3 -m unittest discover -s tests -v
+"""
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from test_privacy_audit import FAKE_TV, OWN_DUMP  # noqa: E402
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "tools"))
+import privacy  # noqa: E402
+import recovery  # noqa: E402
+
+# The fake TV, plus one thing a real run can meet: the file appears while the audit runs.
+APPEARING_TV = FAKE_TV.replace("def main():", '''_connect = connect
+
+
+def connect():
+    device = _connect()
+    if state.get("appears"):
+        with open(state["appears"], "w") as f:
+            f.write("# written during the audit\\n")
+    return device
+
+
+def main():''', 1)
+KATNISS = "com.google.android.katniss"
+MATCHES = [f"com.example.voice{i:02d}" for i in range(30)]
+
+
+class PrivacyWriteTargetTest(unittest.TestCase):
+    def setUp(self):
+        tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(tmp.cleanup)
+        self.base = Path(tmp.name)
+        self.repo = self.base / "repo"
+        tools = self.repo / "tools"
+        tools.mkdir(parents=True)
+        shutil.copy2(ROOT / "tools" / "privacy.py", tools / "privacy.py")
+        (tools / "tv.py").write_text(APPEARING_TV)
+        self.script = tools / "privacy.py"
+        self.state_path = self.base / "tv-state.json"
+        self.tv()
+
+    def tv(self, installed=(KATNISS, "com.example.plain"), **overrides):
+        state = {
+            "installed": list(installed),
+            "disabled": [],
+            "voice": {"voice_interaction_service":
+                      "com.google.android.katniss/.search.serviceapi.KatnissVoiceInteractionService"},
+            "dumps": {KATNISS: OWN_DUMP},
+            "appops": {},
+        }
+        state.update(overrides)
+        self.state_path.write_text(json.dumps(state))
+
+    def write(self, target, *args):
+        env = dict(os.environ, TV_HOST="192.168.1.50", FAKE_TV_STATE=str(self.state_path))
+        return subprocess.run([sys.executable, str(self.script), "--write", str(target), *args],
+                              cwd=self.repo, env=env, capture_output=True, text=True,
+                              stdin=subprocess.DEVNULL, timeout=120)
+
+    # The file, before the TV
+
+    def test_an_existing_file_is_refused_before_the_tv_is_asked(self):
+        target = self.repo / "privacy.txt"
+        target.write_text("# hand edits\n")
+        self.tv(unreachable=True)
+        result = self.write("privacy.txt")
+        self.assertEqual(result.returncode, 1)
+        self.assertIn("privacy.txt already exists; move it aside or choose another name.",
+                      result.stderr)
+        self.assertIn("Nothing was asked of the TV.", result.stderr)
+        self.assertNotIn("cannot reach the TV", result.stderr)
+        self.assertEqual(target.read_text(), "# hand edits\n")
+
+    def test_a_missing_folder_is_refused_before_the_tv_is_asked(self):
+        self.tv(unreachable=True)
+        result = self.write("no-such-folder/privacy.txt")
+        self.assertEqual(result.returncode, 1)
+        self.assertNotIn("Traceback", result.stderr)
+        self.assertIn("there is no folder no-such-folder", result.stderr)
+        self.assertIn("Nothing was asked of the TV.", result.stderr)
+        self.assertNotIn("cannot reach the TV", result.stderr)
+        self.assertFalse((self.repo / "no-such-folder").exists())
+
+    def test_a_folder_that_is_a_file_is_refused_too(self):
+        (self.repo / "lists").write_text("not a folder\n")
+        self.tv(unreachable=True)
+        result = self.write("lists/privacy.txt")
+        self.assertEqual(result.returncode, 1)
+        self.assertNotIn("Traceback", result.stderr)
+        self.assertIn("there is no folder lists", result.stderr)
+        self.assertNotIn("cannot reach the TV", result.stderr)
+        self.assertEqual((self.repo / "lists").read_text(), "not a folder\n")
+
+    def test_a_new_file_in_a_folder_that_exists_is_still_written(self):
+        (self.repo / "lists").mkdir()
+        result = self.write("lists/privacy.txt")
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(recovery.read_list(self.repo / "lists" / "privacy.txt"), [KATNISS])
+
+    def test_a_file_that_appears_during_the_audit_is_not_replaced(self):
+        target = self.repo / "privacy.txt"
+        self.tv(appears=str(target))
+        result = self.write("privacy.txt")
+        self.assertEqual(result.returncode, 1)
+        self.assertIn("privacy.txt already exists", result.stderr)
+        # The TV was asked this time, so the refusal must not say it was not.
+        self.assertNotIn("Nothing was asked of the TV", result.stderr)
+        self.assertEqual(target.read_text(), "# written during the audit\n")
+
+    # What the probe cap left out
+
+    def test_include_low_says_how_many_name_matches_were_not_probed(self):
+        self.tv(installed=[KATNISS] + MATCHES)
+        target = self.repo / "low.txt"
+        result = self.write("low.txt", "--include-low")
+        self.assertEqual(result.returncode, 0, result.stderr)
+        # katniss and 24 name matches fill the 25 probes; 6 of the 30 matches are left.
+        self.assertEqual(len(recovery.read_list(target)), privacy.MAX_PROBES)
+        self.assertIn("wrote 25 packages to low.txt", result.stdout)
+        self.assertIn("6 more name matches were not probed (the audit stops at 25)", result.stdout)
+        self.assertIn("`dumpsys package <name>`", result.stdout)
+        text = target.read_text()
+        self.assertIn("# 6 more name matches were not probed (the audit stops at 25)", text)
+        header = text.split("\n\n", 1)[0]
+        self.assertIn("dumpsys package <name>", header)
+        self.assertNotIn("192.168.1.50", text)
+
+    def test_the_count_matches_the_report(self):
+        self.tv(installed=[KATNISS] + MATCHES)
+        env = dict(os.environ, TV_HOST="192.168.1.50", FAKE_TV_STATE=str(self.state_path))
+        report = subprocess.run([sys.executable, str(self.script)], cwd=self.repo, env=env,
+                                capture_output=True, text=True, stdin=subprocess.DEVNULL,
+                                timeout=120).stdout
+        self.assertIn("6 more name matches were not probed", report)
+        result = self.write("low.txt", "--include-low")
+        self.assertIn("6 more name matches were not probed", result.stdout)
+
+    def test_without_include_low_the_list_has_no_name_matches_to_count(self):
+        self.tv(installed=[KATNISS] + MATCHES)
+        target = self.repo / "privacy.txt"
+        result = self.write("privacy.txt")
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(recovery.read_list(target), [KATNISS])
+        self.assertNotIn("not probed", result.stdout)
+        self.assertNotIn("not probed", target.read_text())
+
+    def test_nothing_is_said_when_every_match_was_probed(self):
+        self.tv(installed=[KATNISS] + MATCHES[:5])
+        target = self.repo / "low.txt"
+        result = self.write("low.txt", "--include-low")
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(len(recovery.read_list(target)), 6)
+        self.assertNotIn("not probed", result.stdout)
+        self.assertNotIn("not probed", target.read_text())
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_race_calendar_refusals.py b/tests/test_race_calendar_refusals.py
new file mode 100644
index 00000000..46b4e3c1
--- /dev/null
+++ b/tests/test_race_calendar_refusals.py
@@ -0,0 +1,209 @@
+"""The calendar helper's two ways to fail without a traceback: the folder it is given, and the fetch.
+
+`tools/race_calendar.py` is the one step in this repository that goes online, and it was the last tool
+here that answered its own mistakes with a stack trace: `--season 2027x` went to Jolpica as a URL that
+404s, an offline laptop ended in `urllib.error.URLError: <urlopen error ...>` with eighteen lines above
+it, and a theme folder typed from the wrong directory (`theme/aurora`, missing the `s`) was *created*
+with a calendar in it, so the author pushed a theme that is not the one they meant. Each of those is now
+a sentence on stderr naming the path or the URL and saying that nothing was written, and exit 2 - the
+code the other tools use for a run that could not do its job, next to 1 for a real answer (this season
+has no race left to show) and 0 for a calendar in the theme.
+
+The exit codes and the folder rule are in the script's docstring as well, so the page a reader opens
+first is not the only place they are written down.
+
+Run from the repository root: python3 -m unittest discover -s tests -v
+"""
+import argparse
+import contextlib
+import datetime
+import io
+import json
+from pathlib import Path
+import sys
+import tempfile
+from types import SimpleNamespace
+import unittest
+from unittest import mock
+import urllib.error
+
+from tools import race_calendar
+
+
+RACES = {"MRData": {"RaceTable": {"season": "2026", "Races": [{
+    "round": "1", "raceName": "Example Grand Prix", "date": "2026-01-04", "time": "14:00:00Z",
+}]}}}
+RESPONSE = json.dumps(RACES).encode("utf-8")
+
+
+class FixedDatetime(datetime.datetime):
+    @classmethod
+    def now(cls, tz=None):
+        return cls(2026, 1, 1, tzinfo=tz)
+
+
+def clock():
+    """`datetime` as the script uses it: now() at a fixed moment, plus the two names it needs."""
+    return SimpleNamespace(datetime=FixedDatetime, timedelta=datetime.timedelta,
+                           timezone=datetime.timezone)
+
+
+class SeasonArgumentTest(unittest.TestCase):
+    """--season takes the two forms Jolpica takes, and nothing else reaches it."""
+
+    def test_current_and_a_championship_year_are_accepted(self):
+        self.assertEqual(race_calendar.season("current"), "current")
+        self.assertEqual(race_calendar.season("2026"), "2026")
+        self.assertEqual(race_calendar.season(str(race_calendar.FIRST_SEASON)), str(race_calendar.FIRST_SEASON))
+
+    def test_a_typo_and_a_year_before_the_first_season_are_refused(self):
+        for value in ("2027x", "26", "26x", str(race_calendar.FIRST_SEASON - 1), "1899", "", "2026.5",
+                      "-2026"):
+            with self.subTest(value=value):
+                with self.assertRaises(argparse.ArgumentTypeError) as caught:
+                    race_calendar.season(value)
+                self.assertIn(repr(value), str(caught.exception))
+                self.assertIn(str(race_calendar.FIRST_SEASON), str(caught.exception))
+
+
+class RefusalTest(unittest.TestCase):
+    """What main() answers a folder it does not have, and a fetch that fails."""
+
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.theme = Path(self.tmp.name) / "themes" / "aurora"
+        self.theme.mkdir(parents=True)
+        self.config = self.theme / "config.json"
+        self.err = io.StringIO()
+        self.out = io.StringIO()
+
+    def fetch(self, *args, **kwargs):
+        raise AssertionError("the fetch should not have been made")
+
+    def stub(self, *, body=None, raises=None):
+        if raises is not None:
+            side_effect = raises
+        else:
+            side_effect = lambda *args, **kwargs: io.BytesIO(body if body is not None else RESPONSE)
+        opener = mock.patch.object(race_calendar.urllib.request, "urlopen", side_effect=side_effect)
+        self.urlopen = opener.start()
+        self.addCleanup(opener.stop)
+
+    def run_main(self, *argv):
+        """main() as the shell runs it: (status, stderr), with argparse's own exits caught."""
+        with mock.patch.object(sys, "argv", ["race_calendar.py", *argv]), \
+                mock.patch.object(race_calendar, "datetime", clock()), \
+                contextlib.redirect_stdout(self.out), \
+                contextlib.redirect_stderr(self.err):
+            try:
+                status = race_calendar.main()
+            except SystemExit as e:
+                status = e.code
+        return status, self.err.getvalue()
+
+    def assert_refused(self, status, stderr, *needles):
+        self.assertEqual(status, 2, stderr)
+        self.assertNotIn("Traceback", stderr)
+        for needle in needles:
+            self.assertIn(needle, stderr)
+        self.assertTrue(any("Nothing was written" in line for line in stderr.splitlines()), stderr)
+
+    def test_a_season_that_is_not_a_year_never_reaches_the_api(self):
+        self.stub()
+        status, stderr = self.run_main(str(self.theme), "--season", "2027x")
+        self.assertEqual(status, 2, stderr)
+        self.assertIn("a season is 'current' or a year from 1950 on", stderr)
+        self.assertIn("'2027x'", stderr)
+        self.urlopen.assert_not_called()
+
+    def test_a_theme_folder_that_is_not_there_is_named_and_not_created(self):
+        self.stub()
+        missing = Path(self.tmp.name) / "themes" / "aurora2"     # one letter off the folder above
+        status, stderr = self.run_main(str(missing), "--season", "2026")
+        self.assert_refused(status, stderr, "there is no theme folder at", str(missing))
+        self.assertFalse(missing.exists(), "the run made the folder it was given")
+        self.urlopen.assert_not_called()
+
+    def test_a_theme_path_that_is_a_file_is_refused(self):
+        self.stub()
+        picture = self.theme / "screenshot.jpg"
+        picture.write_bytes(b"jpg")
+        status, stderr = self.run_main(str(picture), "--season", "2026")
+        self.assert_refused(status, stderr, "there is no theme folder at", str(picture))
+        self.urlopen.assert_not_called()
+
+    def test_a_fetch_that_cannot_connect_says_which_url_and_why(self):
+        self.stub(raises=urllib.error.URLError(ConnectionRefusedError(111, "Connection refused")))
+        status, stderr = self.run_main(str(self.theme), "--season", "2026")
+        self.assert_refused(status, stderr, "could not reach Jolpica at",
+                            "api.jolpi.ca/ergast/f1/2026.json", "Connection refused")
+        self.assertFalse(self.config.exists(), "a failed fetch wrote a config.json")
+
+    def test_a_timeout_is_the_same_answer(self):
+        self.stub(raises=TimeoutError("timed out"))
+        status, stderr = self.run_main(str(self.theme), "--season", "2026")
+        self.assert_refused(status, stderr, "could not reach Jolpica at", "timed out")
+
+    def test_an_http_error_names_the_status_the_api_gave(self):
+        self.stub(raises=urllib.error.HTTPError(race_calendar.API.format(season="2026"), 503,
+                                                "Service Unavailable", {}, None))
+        status, stderr = self.run_main(str(self.theme), "--season", "2026")
+        self.assert_refused(status, stderr, "Jolpica answered 503 Service Unavailable")
+
+    def test_a_body_that_is_not_json_is_named_as_such(self):
+        self.stub(body=b"<html><body>502 Bad Gateway</body></html>")
+        status, stderr = self.run_main(str(self.theme), "--season", "2026")
+        self.assert_refused(status, stderr, "answered something that is not JSON", "api.jolpi.ca")
+
+    def test_an_answer_with_no_race_table_is_named(self):
+        self.stub(body=json.dumps({"MRData": {"total": "0"}}).encode("utf-8"))
+        status, stderr = self.run_main(str(self.theme), "--season", "2026")
+        self.assert_refused(status, stderr, "has no MRData.RaceTable in it", "2026")
+
+    def test_a_session_time_the_script_cannot_read_is_named(self):
+        broken = json.loads(json.dumps(RACES))
+        broken["MRData"]["RaceTable"]["Races"][0]["date"] = "4 January 2026"
+        self.stub(body=json.dumps(broken).encode("utf-8"))
+        status, stderr = self.run_main(str(self.theme), "--season", "2026")
+        self.assert_refused(status, stderr, "is not a timestamp this script understands")
+        self.assertFalse(self.config.exists(), "a calendar the script could not read was written")
+
+    def test_a_refused_fetch_leaves_an_existing_theme_byte_identical(self):
+        original = json.dumps({"greeting_name": "Olohuone", "columns": 5}, ensure_ascii=False) + "\n"
+        self.config.write_text(original, encoding="utf-8")
+        self.stub(raises=urllib.error.URLError(OSError("Network is unreachable")))
+        status, stderr = self.run_main(str(self.theme), "--season", "2026")
+        self.assert_refused(status, stderr, "could not reach Jolpica at")
+        self.assertEqual(self.config.read_text(encoding="utf-8"), original)
+
+    def test_a_season_with_no_race_left_is_exit_1_with_its_message(self):
+        # A real answer, not a run that failed: the season's races are all behind the fixed clock.
+        past = json.loads(json.dumps(RACES))
+        past["MRData"]["RaceTable"]["Races"][0]["date"] = "2025-01-04"
+        self.stub(body=json.dumps(past).encode("utf-8"))
+        status, stderr = self.run_main(str(self.theme), "--season", "2026")
+        self.assertEqual(status, 1, stderr)
+        self.assertIn("no upcoming races in the 2026 calendar", stderr)
+        self.assertEqual(self.config.exists(), False)
+
+    def test_a_calendar_the_script_can_read_is_written_and_exits_0(self):
+        self.stub()
+        self.config.write_text(json.dumps({"columns": 5}), encoding="utf-8")
+        status, stderr = self.run_main(str(self.theme), "--season", "2026")
+        self.assertEqual(status, 0, stderr)
+        self.assertEqual(stderr, "")
+        written = json.loads(self.config.read_text(encoding="utf-8"))
+        self.assertEqual(written["columns"], 5)
+        self.assertEqual(written["race_calendar"][0]["name"], "Example Grand Prix")
+
+    def test_the_help_text_still_exits_0_without_fetching(self):
+        self.stub()
+        status, stderr = self.run_main("--help")
+        self.assertEqual(status, 0, stderr)
+        self.assertIn("--season", self.out.getvalue())
+        self.urlopen.assert_not_called()
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_readme_quick_start_clone.py b/tests/test_readme_quick_start_clone.py
new file mode 100644
index 00000000..24ed678b
--- /dev/null
+++ b/tests/test_readme_quick_start_clone.py
@@ -0,0 +1,212 @@
+"""The quick start's second step pasted PROMPT.md and never said to clone the repo first.
+
+PROMPT.md is a prompt, not the repository. It sends the assistant to questions the repo answers:
+`tools/tv.py` for the connection, `tools/disable.sh`, which writes the restore record and holds the
+Home guard, `launcher/build-and-install.sh`, which builds the launcher and checks Home came back,
+`examples/` for a tested list, `docs/` for the notes. Its own opening has one sentence about that -
+"If you cloned this repo, mention that" - and nothing on any page said what to clone, so step 2 of
+the quick start ("paste PROMPT.md into your assistant") was followed literally by a reader who had
+only the web page. #1617 is that session on a TCL 50C755: the assistant answered that "the repo
+tools you mention (tools/tv.py, tools/disable.sh, docs/, examples/) aren't in this folder" and said
+it would write equivalent helper scripts itself, which is the one path the safety rules exist to
+close - a hand-written disable loop has no restore record and no Home guard.
+
+So every README clones first, in the same row that names the prompt, and say why on the line
+under the table: the assistant reuses this repo's `tools/disable.sh` and `launcher/build-and-install.sh`
+instead of writing its own. The paragraph names both scripts rather than describing them, so a reader
+can see what the clone buys before they run anything.
+
+PROMPT.md is the maintainer's file (AGENTS.md, and .github/maintainer/MAINTAINER.md holds it), so the
+prompt-side half of #1617 - naming the repo inside the prompt itself - is left to them; this is the
+installation half the reporter asked for, which is a README.
+
+The owner/repo the clone URL must carry is read out of .github/ISSUE_TEMPLATE/config.yml instead of
+being copied in, so a fork or a rename moves the URL with the page rather than leaving a dead command.
+
+Run from the repository root: python3 -m unittest discover -s tests -v
+"""
+import re
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+ISSUE_TEMPLATE = ROOT / ".github" / "ISSUE_TEMPLATE" / "config.yml"
+PROMPT = ROOT / "PROMPT.md"
+# `| first | second |`, the two-column shape the quick start uses.
+ROW = re.compile(r"^\|\s*(.+?)\s*\|\s*(.+?)\s*\|\s*$")
+SEPARATOR = re.compile(r"^[-: ]+$")
+STEP_TWO = re.compile(r"^\**\s*2\.")
+
+
+def pages():
+    """The English README and every translation beside it."""
+    return [ROOT / "README.md"] + sorted(ROOT.glob("README.*.md"))
+
+
+def rows(text):
+    """Table rows as (first cell, last cell), the separator row dropped."""
+    found = []
+    for line in text.splitlines():
+        match = ROW.match(line.strip())
+        if not match or SEPARATOR.match(match.group(1)):
+            continue
+        found.append((match.group(1), match.group(2)))
+    return found
+
+
+def prompt_rows(text):
+    """The table rows that name PROMPT.md - the quick start's paste step is meant to be the only one."""
+    return [(first, rest) for first, rest in rows(text) if "PROMPT.md" in rest]
+
+
+def slug():
+    """owner/repo, read from the issue template's links so a rename moves the clone URL too."""
+    match = re.search(r"github\.com/([\w.-]+/[\w.-]+)/", ISSUE_TEMPLATE.read_text(encoding="utf-8"))
+    return match.group(1) if match else ""
+
+
+def clone_problems(text, owner_repo):
+    """What is wrong with a page's paste step, as sentences; empty when the step clones first."""
+    found = prompt_rows(text)
+    if len(found) != 1:
+        return [f"{len(found)} table rows name PROMPT.md: the quick start must have one paste step"]
+    first, rest = found[0]
+    problems = []
+    if not STEP_TWO.match(first):
+        problems.append(f"the row naming PROMPT.md reads {first!r}, not step 2")
+    if "git clone" not in rest:
+        problems.append("the row that pastes PROMPT.md does not clone the repo first")
+    elif f"github.com/{owner_repo}" not in rest:
+        problems.append(f"the clone command does not name github.com/{owner_repo}")
+    elif rest.index("git clone") > rest.index("PROMPT.md"):
+        problems.append("the clone command comes after PROMPT.md in the row")
+    return problems
+
+
+def note_after(text, needle):
+    """The paragraph that follows the table row containing `needle`, wrapping joined, or ''."""
+    lines = text.splitlines()
+    for index, line in enumerate(lines):
+        if line.strip().startswith("|") and needle in line:
+            rest = lines[index + 1:]
+            break
+    else:
+        return ""
+    while rest and (rest[0].strip().startswith("|") or not rest[0].strip()):
+        rest = rest[1:]
+    paragraph = []
+    for line in rest:
+        if not line.strip():
+            break
+        paragraph.append(line.strip())
+    return " ".join(paragraph)
+
+
+class TheCloneStep(unittest.TestCase):
+    def test_the_slug_is_read_out_of_the_issue_template(self):
+        self.assertTrue(ISSUE_TEMPLATE.is_file(), "no .github/ISSUE_TEMPLATE/config.yml to read the repo from")
+        self.assertRegex(slug(), r"^[\w.-]+/[\w.-]+$",
+                         "the issue template names no github.com/<owner>/<repo> URL")
+
+    def test_five_readmes_are_read(self):
+        found = pages()
+        self.assertEqual(5, len(found), f"expected README.md and four translations, read {[p.name for p in found]}")
+        for page in found:
+            self.assertGreaterEqual(len(rows(page.read_text(encoding="utf-8"))), 3,
+                                    f"{page.name} parses as fewer than three table rows")
+
+    def test_every_readme_clones_before_it_pastes_the_prompt(self):
+        owner_repo = slug()
+        for page in pages():
+            with self.subTest(page=page.name):
+                problems = clone_problems(page.read_text(encoding="utf-8"), owner_repo)
+                self.assertEqual([], problems, f"{page.name}: {problems}")
+
+    def test_the_line_under_the_table_says_what_the_clone_buys(self):
+        """The two scripts the assistant would otherwise rewrite, named as paths so they are findable."""
+        for page in pages():
+            with self.subTest(page=page.name):
+                note = note_after(page.read_text(encoding="utf-8"), "PROMPT.md")
+                for path in ("tools/disable.sh", "launcher/build-and-install.sh"):
+                    self.assertIn(path, note,
+                                  f"{page.name}'s line under the quick start does not name {path}: {note!r}")
+
+    def test_the_prompt_still_assumes_a_clone(self):
+        """The page sends a reader to clone because the prompt's own opening asks about it."""
+        self.assertIn("If you cloned this repo", PROMPT.read_text(encoding="utf-8"),
+                      "PROMPT.md no longer mentions a clone, so the README's clone step has nothing behind it")
+
+
+class TheReader(unittest.TestCase):
+    """clone_problems() against pages written here, so a broken reader fails rather than the page."""
+
+    GOOD = (
+        "| Where | What to do |\n"
+        "|---|---|\n"
+        "| **1. On the TV** | USB debugging on. |\n"
+        "| **2. On your computer** | Clone the repo (`git clone https://github.com/o/r`), then paste "
+        "[`PROMPT.md`](PROMPT.md). |\n"
+    )
+
+    def test_a_page_that_clones_first_is_quiet(self):
+        self.assertEqual([], clone_problems(self.GOOD, "o/r"))
+
+    def test_a_row_without_the_clone_is_reported(self):
+        text = self.GOOD.replace("Clone the repo (`git clone https://github.com/o/r`), then paste ",
+                                 "Paste ")
+        self.assertEqual(["the row that pastes PROMPT.md does not clone the repo first"],
+                         clone_problems(text, "o/r"))
+
+    def test_a_clone_after_the_prompt_is_reported(self):
+        text = self.GOOD.replace(
+            "Clone the repo (`git clone https://github.com/o/r`), then paste [`PROMPT.md`](PROMPT.md).",
+            "Paste [`PROMPT.md`](PROMPT.md) from `git clone https://github.com/o/r`.")
+        self.assertEqual(["the clone command comes after PROMPT.md in the row"], clone_problems(text, "o/r"))
+
+    def test_another_repository_is_reported(self):
+        text = self.GOOD.replace("github.com/o/r", "github.com/someone/fork")
+        self.assertEqual(["the clone command does not name github.com/o/r"], clone_problems(text, "o/r"))
+
+    def test_the_step_number_is_read(self):
+        text = self.GOOD.replace("**2. On your computer**", "**4. Later**")
+        self.assertEqual(["the row naming PROMPT.md reads '**4. Later**', not step 2"],
+                         clone_problems(text, "o/r"))
+
+    def test_two_rows_naming_the_prompt_are_reported(self):
+        text = self.GOOD + "| **3. Later** | Paste [`PROMPT.md`](PROMPT.md) again. |\n"
+        self.assertEqual(["2 table rows name PROMPT.md: the quick start must have one paste step"],
+                         clone_problems(text, "o/r"))
+
