+<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:id="@+id/chipRoot"
+    android:layout_width="wrap_content"
+    android:layout_height="28dp"
+    android:layout_marginEnd="8dp"
+    android:background="@drawable/bg_event_chip"
+    android:gravity="center_vertical"
+    android:orientation="horizontal"
+    android:paddingStart="10dp"
+    android:paddingEnd="14dp">
+
+    <ImageView
+        android:id="@+id/chipIcon"
+        android:layout_width="16dp"
+        android:layout_height="16dp"
+        android:contentDescription="Event"
+        android:src="@drawable/ic_event_moon" />
+
+    <TextView
+        android:id="@+id/chipTitle"
+        android:layout_width="wrap_content"
+        android:layout_height="wrap_content"
+        android:layout_marginStart="6dp"
+        android:ellipsize="end"
+        android:fontFamily="@font/lexend_medium"
+        android:includeFontPadding="false"
+        android:singleLine="true"
+        android:textColor="#FFFFFFFF"
+        android:textSize="13sp" />
+
+    <TextView
+        android:id="@+id/chipWhen"
+        android:layout_width="wrap_content"
+        android:layout_height="wrap_content"
+        android:layout_marginStart="6dp"
+        android:ellipsize="end"
+        android:fontFamily="@font/lexend"
+        android:includeFontPadding="false"
+        android:singleLine="true"
+        android:textColor="#8CFFFFFF"
+        android:textSize="13sp" />
+</LinearLayout>
diff --git a/launcher/app/src/main/res/layout/item_weather_day.xml b/launcher/app/src/main/res/layout/item_weather_day.xml
new file mode 100644
index 00000000..c9fc96ff
--- /dev/null
+++ b/launcher/app/src/main/res/layout/item_weather_day.xml
@@ -0,0 +1,62 @@
+<?xml version="1.0" encoding="utf-8"?>
+<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:layout_width="0dp"
+    android:layout_weight="1"
+    android:layout_height="wrap_content"
+    android:gravity="center_horizontal"
+    android:orientation="vertical">
+
+    <TextView
+        android:id="@+id/wxDayName"
+        android:layout_width="wrap_content"
+        android:layout_height="wrap_content"
+        android:fontFamily="@font/lexend_medium"
+        android:textColor="#B3FFFFFF"
+        android:textSize="12sp"
+        android:includeFontPadding="false" />
+
+    <ImageView
+        android:id="@+id/wxDayIcon"
+        android:layout_width="22dp"
+        android:layout_height="22dp"
+        android:layout_marginTop="6dp"
+        android:layout_marginBottom="6dp"
+        android:contentDescription="Day forecast"
+        android:src="@drawable/ic_weather_clear_day" />
+
+    <LinearLayout
+        android:layout_width="wrap_content"
+        android:layout_height="wrap_content"
+        android:gravity="center_vertical"
+        android:orientation="horizontal">
+
+        <TextView
+            android:id="@+id/wxDayMax"
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content"
+            android:fontFamily="@font/lexend_medium"
+            android:textColor="#FFFFFFFF"
+            android:textSize="12sp"
+            android:includeFontPadding="false" />
+
+        <TextView
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content"
+            android:layout_marginStart="2dp"
+            android:layout_marginEnd="2dp"
+            android:fontFamily="@font/lexend"
+            android:textColor="#66FFFFFF"
+            android:textSize="11sp"
+            android:text="/"
+            android:includeFontPadding="false" />
+
+        <TextView
+            android:id="@+id/wxDayMin"
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content"
+            android:fontFamily="@font/lexend_light"
+            android:textColor="#8CFFFFFF"
+            android:textSize="12sp"
+            android:includeFontPadding="false" />
+    </LinearLayout>
+</LinearLayout>
