new file mode 100644
index 00000000..e17d01bc
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/BootHome.java
@@ -0,0 +1,165 @@
+package com.gathin.tvhome;
+
+import android.Manifest;
+import android.content.BroadcastReceiver;
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.PackageManager;
+import android.os.Handler;
+import android.os.Looper;
+import android.provider.Settings;
+import android.util.Log;
+
+/**
+ * CleanTV/VGS: power_on_home_always (and stock_home_redirect) without the helper. On TCL (43P618, Smart TV Pro, 27/10/2026) the TV came back on the
+ * stock home after a real power-off: the firmware drops HomeKeyService from the accessibility list at boot (or binds it
+ * after the stock home is already up), so nothing redirected. At BOOT_COMPLETED this puts HomeKeyService back on the list
+ * when CleanTV granted WRITE_SECURE_SETTINGS, then opens this Home once the firmware has brought up its own. Starting an
+ * activity from a receiver needs the SYSTEM_ALERT_WINDOW app op, which CleanTV sets over ADB; without it the start is
+ * just refused.
+ */
+public class BootHome extends BroadcastReceiver {
+    /** After the firmware's own home or last source is up (TCL Google TV: about 3 s after BOOT_COMPLETED). */
+    static final long OPEN_DELAY_MS = 4000L;
+    /** Logcat tag CleanTV reads back in its Home diagnosis (3.5.3): did the boot path run, and what stopped it. */
+    static final String TAG = "CleanTVBoot";
+
+    @Override
+    public void onReceive(Context context, Intent intent) {
+        String action = intent.getAction();
