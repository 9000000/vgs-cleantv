+package com.gathin.tvhome;
+
+import android.Manifest;
+import android.content.BroadcastReceiver;
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.PackageManager;
+import android.os.Handler;
+import android.os.Looper;
+import android.provider.Settings;
+import android.util.Log;
+
+/**
+ * CleanTV/VGS: power_on_home_always (and stock_home_redirect) without the helper. On TCL (43P618, Smart TV Pro, 27/10/2026) the TV came back on the
+ * stock home after a real power-off: the firmware drops HomeKeyService from the accessibility list at boot (or binds it
+ * after the stock home is already up), so nothing redirected. At BOOT_COMPLETED this puts HomeKeyService back on the list
+ * when CleanTV granted WRITE_SECURE_SETTINGS, then opens this Home once the firmware has brought up its own. Starting an
+ * activity from a receiver needs the SYSTEM_ALERT_WINDOW app op, which CleanTV sets over ADB; without it the start is
+ * just refused.
+ */
+public class BootHome extends BroadcastReceiver {
+    /** After the firmware's own home or last source is up (TCL Google TV: about 3 s after BOOT_COMPLETED). */
+    static final long OPEN_DELAY_MS = 4000L;
+    /** Logcat tag CleanTV reads back in its Home diagnosis (3.5.3): did the boot path run, and what stopped it. */
+    static final String TAG = "CleanTVBoot";
+
+    @Override
+    public void onReceive(Context context, Intent intent) {
+        String action = intent.getAction();
+        if (!Intent.ACTION_BOOT_COMPLETED.equals(action) && (action == null || !action.endsWith("QUICKBOOT_POWERON"))) return;
+        wake(context, action.endsWith("QUICKBOOT_POWERON") ? "q" : "b", goAsync());
+    }
+
+    /** CleanTV/VGS 3.5.6: a wake from a bind Android makes at boot (NowPlayingListener), counted only this early. */
+    static final long BIND_WAKE_MS = 10 * 60 * 1000L;
+
+    /**
+     * The boot path, once per boot whichever signal comes first. TCL 43P618 (Võ Thái, 27/10/2026, boot record
+     * "h307 h309 h320 s324"): no BOOT_COMPLETED reached this app and the helper stayed off until CleanTV connected, so
+     * 3.5.6 also starts it from the notification listener, which Android binds at boot by itself.
+     */
+    static void wake(Context context, String event, BroadcastReceiver.PendingResult pending) {
+        // Noted before the once-per-boot check, so the record shows every way in that worked ("b7 n8").
+        note(context, event);
+        // Once per boot: firmware that sends several signals would open Home twice.
+        int boot = Settings.Global.getInt(context.getContentResolver(), Settings.Global.BOOT_COUNT, -1);
+        android.content.SharedPreferences prefs = context.getSharedPreferences("boot", Context.MODE_PRIVATE);
+        if (boot >= 0 && prefs.getInt("boot_home", -1) == boot) {
+            if (pending != null) pending.finish();
+            return;
+        }
+        prefs.edit().putInt("boot_home", boot).apply();
+        decide(context, event, pending, 0);
+    }
+
+    /** CleanTV/VGS 3.5.7: how often, and how long after boot, an early wake reads the config again. */
+    static final long RETRY_MS = 15_000L;
+    static final long RETRY_UNTIL_MS = 2 * 60 * 1000L;
+    /** Whether an earlier read this boot found a config (for the "u" note). */
+    private static boolean wasApplied;
+
+    /**
+     * TCL 43P618 on 3.5.6 (Võ Thái, 28/10/2026): the bind wake came so early that boot_count had not moved yet and the
+     * config read "redirect=false always=false", while the helper three minutes later found stock_home_redirect set.
+     * An early read that finds neither switch is read again every 15 s for the first 2 minutes ("c" in the record);
+     * later than that the person may already be in an app, and the helper covers the stock home when it comes up.
+     */
+    private static void decide(Context context, String event, BroadcastReceiver.PendingResult pending, int tries) {
+        Config config = Config.load(context);
+        boolean redirect = !config.stockHomeRedirect.isEmpty();
+        Log.i(TAG, "boot " + event + " redirect=" + redirect + " always=" + config.powerOnHomeAlways + " liveTv=" + config.bootToLiveTv
+                + (tries > 0 ? " try " + tries : ""));
+        if (tries > 0 && (redirect || config.powerOnHomeAlways)) note(context, "c");
+        // 3.5.8: no config at all (neither config.json nor the kept copy) is a folder not ready yet, whatever the uptime.
+        // TCL 43P618 again (Võ Thái, 28/10/2026): the bind wake came 220 s after boot and still read nothing, the
+        // helper 9 s later read stock_home_redirect. Noted once as "u" with the uptime the config first read.
+        if (!config.overlayApplied && tries == 0) note(context, "l");
+        if (config.overlayApplied && tries > 0 && !wasApplied) note(context, "u");
+        if (config.overlayApplied) wasApplied = true;
