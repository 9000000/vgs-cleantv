-            return (Boolean) BluetoothA2dp.class.getMethod(connect ? "connect" : "disconnect", BluetoothDevice.class)
-                    .invoke(a2dp, device);
-        } catch (ReflectiveOperationException | SecurityException refused) {
-            return false;
-        }
-    }
-}
