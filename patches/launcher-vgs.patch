+<?xml version="1.0" encoding="utf-8"?>
+<resources>
+    <string name="app_name">News screensaver</string>
+    <string name="dream_name">News</string>
+    <string name="loading_title">Fetching the news…</string>
+    <string name="offline_title">No news right now</string>
+    <string name="offline_body">The feeds could not be reached. Check the TV\'s network connection and the feed addresses; the screensaver tries again in a couple of minutes.</string>
+    <string name="no_feeds_title">No feeds</string>
+    <string name="no_feeds_body">Add an RSS or Atom feed in the screensaver\'s settings, or with setup.sh.</string>
+    <string name="settings_title">News screensaver</string>
+    <string name="seconds_per_headline">Seconds per headline: %1$d</string>
+    <string name="feeds_heading">Feeds (OK on one removes it)</string>
+    <string name="feed_hint">Name | https://example.com/rss.xml (the name is optional)</string>
