-com.google.android.tv.assistant               # assistant LED / hotword service
-# com.google.android.tv.remote.service        # phone-app remote; disabled on the tested unit, uncomment to do the same (shared lists keep it on)
-
-# XGIMI extras (off by choice)
-com.xgimi.doubanfm                            # XGIMI music app, speaker-mode screen
-
-# Kept by choice on this unit: every preinstalled streaming app (Netflix, YouTube, Prime Video, Disney+,
-# Apple TV, Canal+, Orange TV, Spotify, france.tv, TF1+, M6+, Arte), com.google.android.apps.mediashell
-# (Chromecast), com.xgimi.ota.accessories, com.xgimi.gimiplayer, com.google.android.apps.tv.dreamx
