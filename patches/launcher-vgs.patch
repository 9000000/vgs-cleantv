+<?xml version="1.0" encoding="utf-8"?>
+<!-- CleanTV/VGS: nút tròn trong cụm — trong suốt, sáng trắng khi được chọn. -->
+<selector xmlns:android="http://schemas.android.com/apk/res/android">
+    <item android:state_focused="true">
+        <shape android:shape="oval"><solid android:color="#F5FFFFFF" /></shape>
+    </item>
+    <item android:state_activated="true">
+        <shape android:shape="oval"><solid android:color="#596EC1FF" /><stroke android:width="1.5dp" android:color="#FF6EC1FF" /></shape>
+    </item>
+    <item><shape android:shape="oval"><solid android:color="#00000000" /></shape></item>
+</selector>
