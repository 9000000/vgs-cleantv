+/**
+ * CleanTV/VGS: Khối "Ngày này năm xưa" (Wikipedia tiếng Việt / On this day).
+ * Đọc sự kiện lịch sử tích cực trong ngày, lọc bỏ nội dung bạo lực/tai nạn (GRIM filter)
+ * để đảm bảo an toàn cho phòng khách gia đình. Có sẵn dữ liệu dự phòng offline.
+ */
+public final class HistoryProvider {
+
+    private HistoryProvider() {
+    }
+
+    public static class HistoryItem {
+        public final int year;
+        public final String text;
+
+        public HistoryItem(int year, String text) {
+            this.year = year;
+            this.text = text;
+        }
+
+        public String getFormatted() {
+            if (year > 0) return "Năm " + year + ": " + text;
+            return text;
+        }
+    }
+
+    public interface Callback {
+        void onLoaded(List<HistoryItem> items);
+    }
+
+    // Bộ lọc an toàn gia đình: loại bỏ sự kiện thảm sát, đánh bom, tai nạn, khủng bố...
+    private static final Pattern GRIM = Pattern.compile(
+            "\\b(kill|dead|death|bomb|attack|massacre|crash|shoot|shot\\b|murder|terror|genocide|hostage)\\b|" +
+            "giết|thảm sát|khủng bố|đánh bom|tử vong|thiệt mạng|xả súng|tai nạn|hành quyết|ám sát|con tin",
+            Pattern.CASE_INSENSITIVE | Pattern.UNICODE_CASE
+    );
+
+    private static final Pattern YEAR_PATTERN = Pattern.compile(
+            "^\\s*(?:\\[\\[)?(\\d{1,4})(?:\\]\\])?\\s*[–—\\-:]?\\s*(.*)"
+    );
+
+    private static final List<HistoryItem> CACHED_ITEMS = Collections.synchronizedList(new ArrayList<>());
+    private static int cachedDay = -1;
+    private static int cachedMonth = -1;
+
+    /**
+     * Tải sự kiện của ngày hôm nay (chạy ngầm, gọi callback trên main thread).
+     */
+    public static void loadToday(Callback callback) {
+        Calendar cal = Calendar.getInstance();
+        int day = cal.get(Calendar.DAY_OF_MONTH);
+        int month = cal.get(Calendar.MONTH) + 1;
+
+        if (day == cachedDay && month == cachedMonth && !CACHED_ITEMS.isEmpty()) {
+            if (callback != null) callback.onLoaded(new ArrayList<>(CACHED_ITEMS));
+            return;
+        }
+
+        new Thread(() -> {
+            List<HistoryItem> items = fetchFromWikipedia(day, month);
+            if (items.isEmpty()) {
+                items = getFallbackEvents(day, month);
+            }
+
+            CACHED_ITEMS.clear();
+            CACHED_ITEMS.addAll(items);
+            cachedDay = day;
+            cachedMonth = month;
+
+            final List<HistoryItem> result = new ArrayList<>(items);
+            new Handler(Looper.getMainLooper()).post(() -> {
+                if (callback != null) callback.onLoaded(result);
+            });
+        }).start();
+    }
+
+    private static List<HistoryItem> fetchFromWikipedia(int day, int month) {
+        List<HistoryItem> list = new ArrayList<>();
+        HttpURLConnection conn = null;
+        try {
+            URL url = new URL("https://vi.wikipedia.org/w/api.php?action=parse&page=" + day + "_th%C3%A1ng_" + month + "&prop=wikitext&format=json");
+            conn = (HttpURLConnection) url.openConnection();
+            conn.setRequestMethod("GET");
+            conn.setRequestProperty("User-Agent", "CleanTV-AndroidTV/2.10 (https://vgs.zone/cleantv)");
+            conn.setConnectTimeout(8000);
+            conn.setReadTimeout(8000);
+
+            if (conn.getResponseCode() == 200) {
+                BufferedReader br = new BufferedReader(new InputStreamReader(conn.getInputStream(), "UTF-8"));
+                StringBuilder sb = new StringBuilder();
+                String line;
+                while ((line = br.readLine()) != null) sb.append(line);
+                br.close();
+
+                JSONObject root = new JSONObject(sb.toString());
+                JSONObject parseObj = root.optJSONObject("parse");
+                if (parseObj != null) {
+                    JSONObject wtObj = parseObj.optJSONObject("wikitext");
+                    if (wtObj != null) {
+                        String wikitext = wtObj.optString("*", "");
+                        int start = wikitext.indexOf("== Sự kiện ==");
+                        if (start == -1) start = wikitext.indexOf("==Sự kiện==");
+                        if (start != -1) {
+                            int end = wikitext.indexOf("\n==", start + 12);
+                            String section = (end != -1) ? wikitext.substring(start, end) : wikitext.substring(start);
+                            String[] lines = section.split("\n");
+                            for (String l : lines) {
+                                l = l.trim();
+                                if (!l.startsWith("*")) continue;
+                                l = l.replaceFirst("^\\*+", "").trim();
+                                Matcher m = YEAR_PATTERN.matcher(l);
+                                if (m.matches()) {
+                                    int year = Integer.parseInt(m.group(1));
+                                    String text = cleanWikiText(m.group(2));
+                                    if (!text.isEmpty() && !GRIM.matcher(text).find()) {
+                                        list.add(new HistoryItem(year, text));
+                                    }
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        } catch (Exception ignored) {
+        } finally {
+            if (conn != null) conn.disconnect();
+        }
+        return list;
+    }
+
+    private static String cleanWikiText(String s) {
+        if (s == null) return "";
+        s = s.replaceAll("(?s)<ref[^>]*>.*?</ref>", "");
+        s = s.replaceAll("<[^>]*>", "");
+        s = s.replaceAll("\\{\\{[^}]*\\}\\}", "");
+        s = s.replaceAll("\\[\\[(?:[^|\\]]*\\|)?([^\\]]+)\\]\\]", "$1");
+        s = s.replaceAll("^[\\s*–—\\-:]+", "");
+        return s.replaceAll("\\s+", " ").trim();
+    }
+
+    /**
+     * Dữ liệu offline dự phòng cho các ngày tiêu biểu.
+     */
+    private static List<HistoryItem> getFallbackEvents(int day, int month) {
+        List<HistoryItem> list = new ArrayList<>();
+        if (month == 1 && day == 1) {
+            list.add(new HistoryItem(1804, "Haiti tuyên bố độc lập, trở thành nước cộng hòa da đen đầu tiên trên thế giới."));
+            list.add(new HistoryItem(1959, "Cách mạng Cuba thành công, mở ra kỷ nguyên mới cho đất nước Cuba."));
+        } else if (month == 4 && day == 30) {
+            list.add(new HistoryItem(1975, "Chiến dịch Hồ Chí Minh toàn thắng, non sông Việt Nam hoàn toàn thu về một mối."));
+        } else if (month == 5 && day == 7) {
+            list.add(new HistoryItem(1954, "Chiến thắng Điện Biên Phủ lừng lẫy năm châu, chấn động địa cầu."));
+        } else if (month == 9 && day == 2) {
+            list.add(new HistoryItem(1945, "Chủ tịch Hồ Chí Minh đọc Tuyên ngôn Độc lập tại Quảng trường Ba Đình, khai sinh nước Việt Nam Dân chủ Cộng hòa."));
+        } else if (month == 10 && day == 10) {
+            list.add(new HistoryItem(1954, "Ngày Giải phóng Thủ đô: Đoàn quân chiến thắng tiến vào tiếp quản Hà Nội."));
+        } else {
+            list.add(new HistoryItem(0, "Một ngày có ý nghĩa đặc biệt trong lịch sử dựng nước và giữ nước của dân tộc Việt Nam."));
+            list.add(new HistoryItem(0, "Mỗi ngày trôi qua là một trang sử mới do chính gia đình bạn viết nên."));
+        }
+        return list;
+    }
+
+    public static HistoryItem getItemAt(int index) {
+        if (CACHED_ITEMS.isEmpty()) return null;
+        int idx = Math.floorMod(index, CACHED_ITEMS.size());
+        return CACHED_ITEMS.get(idx);
+    }
+}
