diff --git a/launcher/app/src/test/java/com/gathin/tvhome/FamilyFeaturesTest.java b/launcher/app/src/test/java/com/gathin/tvhome/FamilyFeaturesTest.java
new file mode 100644
index 00000000..dbed0a30
--- /dev/null
+++ b/launcher/app/src/test/java/com/gathin/tvhome/FamilyFeaturesTest.java
@@ -0,0 +1,133 @@
+package com.gathin.tvhome;
+
+import org.junit.Test;
+
+import java.util.List;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertTrue;
+
+/**
+ * Unit tests for family features (EventsTracker, QuotesProvider, HistoryProvider).
+ */
+public class FamilyFeaturesTest {
+
+    @Test
+    public void testEventsTrackerTetCountdown() {
+        EventsTracker.EventInfo tet = EventsTracker.countdownTet();
+        assertNotNull("Tet event should not be null", tet);
+        assertTrue("Days remaining should be non-negative", tet.daysRemaining >= 0);
+        assertTrue("Days remaining should be within 385 days", tet.daysRemaining <= 385);
+        assertTrue("Title should contain Tết", tet.title.contains("Tết"));
+        assertNotNull("Formatted string should not be null", tet.formatted);
+        assertFalse("Formatted string should not be empty", tet.formatted.isEmpty());
+    }
+
+    @Test
+    public void testEventsTrackerNearestEvent() {
+        EventsTracker.EventInfo nearest = EventsTracker.getNearestEvent();
+        assertNotNull("Nearest event should not be null", nearest);
+        assertTrue("Days remaining should be non-negative", nearest.daysRemaining >= 0);
+        assertFalse("Formatted text should not be empty", nearest.formatted.isEmpty());
+    }
+
+    @Test
+    public void testQuotesProvider() {
+        assertTrue("Quote count should be at least 30", QuotesProvider.getCount() >= 30);
+        QuotesProvider.QuoteItem today = QuotesProvider.getTodayQuote();
+        assertNotNull("Today quote should not be null", today);
+        assertFalse("Today quote text should not be empty", today.text.isEmpty());
+        assertFalse("Today quote author should not be empty", today.author.isEmpty());
+
+        QuotesProvider.QuoteItem random = QuotesProvider.getRandomQuote();
+        assertNotNull("Random quote should not be null", random);
+
+        QuotesProvider.QuoteItem next = QuotesProvider.getNextQuote(5);
+        assertNotNull("Next quote should not be null", next);
+        assertTrue("Formatted quote should have quotes", next.getFormatted().contains("“"));
+    }
+
+    @Test
+    public void testHistoryProviderFallback() {
+        List<HistoryProvider.HistoryItem> fallback = HistoryProvider.getFallbackEvents(28, 10);
+        assertNotNull("Fallback events should not be null", fallback);
+        assertFalse("Fallback events should not be empty", fallback.isEmpty());
+        for (HistoryProvider.HistoryItem item : fallback) {
+            assertTrue("Fallback event must have valid year > 0", item.year > 0);
+            assertNotNull("Fallback event text must not be null", item.text);
+            assertFalse("Fallback event text must not be empty", item.text.isEmpty());
+            assertTrue("Formatted text should contain year", item.getFormatted().contains("Năm " + item.year));
+        }
+    }
+
+    @Test
+    public void testHistoryProviderCleanWikiText() {
+        String raw = "&nbsp;– [[Thomas Edison|Thomas Alva Edison]] xin cấp [[bằng sáng chế]] đầu tiên.<ref>{{chú thích}}</ref>";
+        String cleaned = HistoryProvider.cleanWikiText(raw);
+        assertEquals("Thomas Alva Edison xin cấp bằng sáng chế đầu tiên.", cleaned);
+
+        String italic = "nhạc kịch ''Don Giovanni'' của Mozart";
+        assertEquals("nhạc kịch Don Giovanni của Mozart", HistoryProvider.cleanWikiText(italic));
+    }
+
+    @Test
+    public void testHistoryProviderParseSubBullets() {
+        String wiki = "== Sự kiện ==\n" +
+                "*[[1945]] –\n" +
+                "**[[Chiến tranh thế giới thứ hai]]: Bộ trưởng Ngoại giao Nhật Bản ký đầu hàng Đồng Minh.\n" +
+                "**[[Chủ tịch Hồ Chí Minh]] đọc [[Tuyên ngôn độc lập (Việt Nam Dân chủ Cộng hòa)|Tuyên ngôn độc lập]] tại [[Quảng trường Ba Đình]].\n" +
+                "*[[1946]] - Bộ tem Chủ tịch [[Hồ Chí Minh]] đầu tiên phát hành.\n" +
+                "\n== Sinh ==";
+
+        List<HistoryProvider.HistoryItem> items = HistoryProvider.parseWikiText(wiki);
+        assertEquals(3, items.size());
+        assertEquals(1945, items.get(0).year);
+        assertEquals(1945, items.get(1).year);
+        assertTrue(items.get(1).text.contains("Chủ tịch Hồ Chí Minh đọc Tuyên ngôn độc lập"));
+        assertEquals(1946, items.get(2).year);
+    }
+
+    @Test
+    public void testHistoryProviderGrimFilter() {
+        String wiki = "== Sự kiện ==\n" +
+                "*[[1459]] – Lê Nghi Dân tiến hành binh biến, sát hại Lê Nhân Tông.\n" +
+                "*[[1998]] – Một máy bay bị không tặc bởi phi công.\n" +
+                "*[[1966]] – Ngày thành lập Học viện Kỹ thuật Quân sự Việt Nam.\n" +
+                "\n== Sinh ==";
+
+        List<HistoryProvider.HistoryItem> items = HistoryProvider.parseWikiText(wiki);
+        assertEquals("Only peaceful/positive events should pass GRIM filter", 1, items.size());
+        assertEquals(1966, items.get(0).year);
+        assertTrue(items.get(0).text.contains("Học viện Kỹ thuật Quân sự"));
+    }
+
+    @Test
+    public void testWeatherContinuousUpdateLogic() {
+        // 1. Kiểm tra hằng số chu kỳ cập nhật
+        assertEquals("Chu kỳ cập nhật thời tiết chuẩn là 30 phút", 30 * 60 * 1000L, Weather.WEATHER_CACHE_TTL_MS);
