+    private void advanceTodayCarousel() {
+        if (!showToday || todayCard == null) return;
+
+        // Xoay vòng giữa:
+        // - CÂU NÓI HAY (Quotes)
+        // - NGÀY NÀY NĂM XƯA (Wikipedia tiếng Việt)
+        // Tuyệt đối không lấy tin tức giật gân, đảm bảo thanh tịnh phòng khách
+        boolean isQuote = (carouselStep % 2 == 0);
+        carouselStep++;
+
+        final String label;
+        final String text;
+        final String meta;
+
+        if (isQuote) {
+            QuotesProvider.QuoteItem q = QuotesProvider.getNextQuote(carouselStep);
+            label = "CÂU NÓI HAY";
+            text = (q.text.startsWith("“") ? q.text : "“" + q.text + "”");
+            meta = (q.author != null && !q.author.isEmpty() ? "— " + q.author : "");
+        } else {
+            HistoryProvider.HistoryItem hi = HistoryProvider.getItemAt(carouselStep / 2);
+            if (hi != null && hi.year > 0) {
+                label = "NGÀY NÀY NĂM XƯA · " + hi.year;
+                text = hi.text;
+                int curYear = Calendar.getInstance().get(Calendar.YEAR);
+                int diff = curYear - hi.year;
+                meta = (diff > 0 ? diff + " năm trước" : "");
+            } else if (hi != null) {
+                label = "NGÀY NÀY NĂM XƯA";
+                text = hi.text;
+                meta = "";
+            } else {
+                QuotesProvider.QuoteItem q = QuotesProvider.getNextQuote(carouselStep);
+                label = "CÂU NÓI HAY";
+                text = (q.text.startsWith("“") ? q.text : "“" + q.text + "”");
+                meta = (q.author != null && !q.author.isEmpty() ? "— " + q.author : "");
+            }
+        }
+
+        todayCard.animate().alpha(0f).setDuration(300).withEndAction(() -> {
+            if (todayLabel != null) todayLabel.setText(label);
+            if (todayText != null) todayText.setText(text);
+            if (todayMeta != null) todayMeta.setText(meta);
+            todayCard.animate().alpha(1f).setDuration(400).start();
+        }).start();
+
