+            if (wxTemp != null) wxTemp.setText(fw.temp + "°");
+            if (wxDesc != null) wxDesc.setText(fw.desc);
+            if (wxMeta != null) wxMeta.setText(fw.meta);
+            if (wxAirDot != null && fw.aqi >= 0) {
+                GradientDrawable dot = new GradientDrawable();
+                dot.setShape(GradientDrawable.OVAL);
+                dot.setColor(fw.aqiColor);
+                wxAirDot.setBackground(dot);
