diff --git a/tests/test_list_header_commands.py b/tests/test_list_header_commands.py
new file mode 100644
index 00000000..45e2bd88
--- /dev/null
+++ b/tests/test_list_header_commands.py
@@ -0,0 +1,240 @@
+"""Two list headers whose commands could not work as written.
+
+examples/ffalcon-r34a0-cn: the header says this firmware denies `pm disable-user` to the shell, yet its
+Apply line ran tools/disable.sh, which sends nothing else. It now hides with the `pm hide` batch that
+examples/redmi-mitv-antl0 uses for the same Android 5.1 refusal, and gives `pm unhide` as the undo
+AGENTS.md asks for next to any `pm hide`. The test runs each header's command with tools/venv/bin/python
+replaced by a stand-in that keeps what `tools/tv.py --batch` was given.
+
+examples/anker-nebula-mars-3-air: the header and README said `tools/check.py --fix` re-disables
+Assistant after a boot, but the list keeps com.google.android.katniss commented out and check.py reads
+only active lines, so --fix never touched it. They now say to uncomment it and its LED service, then
+run Apply again: check.py --fix never writes the recovery record, and restore.sh leaves alone every
+listed name the record does not hold, so only disable.sh can make Undo bring them back. The owner's
+choice stays: the shipped list still leaves Assistant on. That half reuses the drift check's harness and
+fake tools/tv.py from tests/test_drift_check.py, and runs the real disable.sh and restore.sh against
+it with run_script from tests/test_recovery_record.py.
+
+Run from the repository root: python3 -m unittest discover -s tests -v
+"""
+import os
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "tools"))
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import recovery  # noqa: E402
+import test_drift_check as drift  # noqa: E402  (imported as a module so its tests do not run twice)
+import test_recovery_record as record_test  # noqa: E402  (the same)
+
+# Lists whose firmware refuses `pm disable-user` for the shell, so the header hides instead.
+HIDE_LISTS = ("redmi-mitv-antl0", "ffalcon-r34a0-cn")
+ANKER = ROOT / "examples" / "anker-nebula-mars-3-air"
+ASSISTANT = ("com.google.android.katniss", "com.google.android.tv.assistant")
+LAUNCHERX = "com.google.android.apps.tv.launcherx"
+
+# Stands in for tools/venv/bin/python running tools/tv.py: keeps the arguments, TV_HOST and the
+# --batch input instead of sending anything to a TV.
+FAKE_CLIENT = '#!/bin/sh\nprintf "%s\\n" "$TV_HOST $*" > "$ARGS"\ncat > "$CAPTURE"\n'
+
+
+def header(path):
+    """The comment lines above a list's first package line."""
+    lines = []
+    for line in path.read_text(encoding="utf-8").splitlines():
+        if line.strip() and not line.lstrip().startswith("#"):
+            break
+        lines.append(line)
+    return lines
+
+
+def hide_command(lines):
+    """The `grep ... | tools/tv.py --batch` pipeline a header gives, continuation lines joined."""
+    body = [line.lstrip("#").strip() for line in lines]
+    start = next((i for i, text in enumerate(body) if text.startswith("grep ")), None)
+    if start is None:
+        return None
+    parts = []
+    for text in body[start:]:
+        parts.append(text.rstrip("\\").strip())
+        if not text.endswith("\\"):
+            break
+    return " ".join(parts)
+
+
+class HideHeaderTest(unittest.TestCase):
+    def run_command(self, folder, command):
+        with tempfile.TemporaryDirectory() as tmp:
+            repo = Path(tmp) / "repo"
+            listing = repo / "examples" / folder / "debloat.txt"
+            listing.parent.mkdir(parents=True)
+            listing.write_bytes((ROOT / "examples" / folder / "debloat.txt").read_bytes())
+            client = repo / "tools" / "venv" / "bin" / "python"
+            client.parent.mkdir(parents=True)
+            client.write_text(FAKE_CLIENT)
+            client.chmod(0o755)
+            args, capture = Path(tmp) / "args.txt", Path(tmp) / "commands.txt"
+            env = dict(os.environ, ARGS=str(args), CAPTURE=str(capture))
+            env.pop("TV_HOST", None)
+            result = subprocess.run(["bash", "-c", "set -o pipefail; " + command], cwd=repo, env=env,
+                                    capture_output=True, text=True, stdin=subprocess.DEVNULL,
+                                    timeout=60)
+            self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+            return args.read_text().split(), capture.read_text().splitlines()
+
+    def test_the_apply_command_hides_every_listed_package(self):
+        for folder in HIDE_LISTS:
+            with self.subTest(folder=folder):
+                command = hide_command(header(ROOT / "examples" / folder / "debloat.txt"))
+                self.assertIsNotNone(command, "the header gives no `pm hide` batch to apply the list")
+                self.assertIn(f"examples/{folder}/debloat.txt", command)
+                self.assertIn("TV_HOST=<tv ip>", command)
+                args, sent = self.run_command(folder, command.replace("<tv ip>", "192.168.1.50"))
+                self.assertEqual(args, ["192.168.1.50", "-I", "tools/tv.py", "--batch"])
+                listed = recovery.read_list(ROOT / "examples" / folder / "debloat.txt")
+                self.assertEqual(sent, [f"pm hide {name}" for name in listed])
+
+    def test_the_undo_line_unhides_and_no_line_runs_the_disable_scripts(self):
+        for folder in HIDE_LISTS:
+            with self.subTest(folder=folder):
+                lines = header(ROOT / "examples" / folder / "debloat.txt")
+                text = "\n".join(lines)
+                undo = text[text.index("Undo:"):]
+                self.assertIn("pm unhide", undo.split("\n#\n", 1)[0])
+                for line in lines:
+                    # tools/disable.sh and restore.sh send pm disable-user and pm enable, which
+                    # these firmwares refuse or which cannot undo a hide.
+                    self.assertNotRegex(line, r"tools[/\\](disable|restore)\.(sh|ps1)\s+\S*debloat")
+
+
+class AnkerAssistantTest(unittest.TestCase):
+    # The drift check's own harness: the same temporary repo, list, fake TV state and runner.
+    write_list = drift.DriftCheckTest.write_list
+    tv = drift.DriftCheckTest.tv
+    run_check = drift.DriftCheckTest.run_check
+    sent = drift.DriftCheckTest.sent
+    # The recovery record test's runner for disable.sh and restore.sh, on the same repo and state.
+    run_script = record_test.RecoveryRecordTest.run_script
+
+    def setUp(self):
+        drift.DriftCheckTest.setUp(self)
+        self.text = (ANKER / "debloat.txt").read_text(encoding="utf-8")
+        paragraph = []
+        for line in header(ANKER / "debloat.txt"):
+            if "Re-enabled by the firmware at every boot" in line or paragraph:
+                if line.strip() == "#":
+                    break
+                paragraph.append(line.lstrip("#").strip())
+        self.paragraph = " ".join(paragraph)
+
+    def told_to_uncomment(self):
+        self.assertIn("check.py --fix", self.paragraph)
+        self.assertIn("uncomment", self.paragraph,
+                      "check.py reads only active lines, so --fix needs the line uncommented first")
+        told = self.paragraph.split("uncomment", 1)[1].split("check.py", 1)[0]
+        return re.findall(r"com\.google\.android\.[a-z.]*[a-z]", told)
+
+    def uncommented(self, names):
+        text = self.text
+        for name in names:
+            # A package line that was commented out: the name alone, or followed by its own note.
+            text, count = re.subn(rf"^# ({re.escape(name)})(?=\s+#|\s*$)", r"\1", text, flags=re.M)
+            self.assertEqual(count, 1, f"no commented-out line for {name} in the list")
+        return text
+
+    def put_list(self, text):
+        self.list_path.write_text(text, encoding="utf-8")
+        listed = recovery.read_list(self.list_path)
+        installed = listed + list(ASSISTANT) + [drift.CUSTOM]
+        # Every listed package stays disabled; the firmware turned Assistant back on at boot.
+        self.tv(installed=installed, disabled=[name for name in listed if name not in ASSISTANT],
+                home=f"{drift.CUSTOM}/.MainActivity",
+                home_activities=[f"{drift.CUSTOM}/.MainActivity", f"{LAUNCHERX}/.MainActivity"])
+
+    def test_the_header_names_the_lines_to_uncomment(self):
+        self.assertEqual(self.told_to_uncomment(), list(ASSISTANT))
+
+    def test_check_fix_re_disables_assistant_once_its_lines_are_uncommented(self):
+        self.put_list(self.uncommented(self.told_to_uncomment()))
+        result = self.run_check("--fix", str(self.list_path))
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        self.assertEqual(self.sent(), [f"pm disable-user --user 0 {name}" for name in ASSISTANT])
+
+    def test_undo_brings_assistant_back_after_the_header_steps(self):
+        # check.py --fix applies the list without touching the recovery record, and restore.sh leaves
+        # alone every listed name the record does not hold, so a package only check.py disabled stays
+        # off after Undo. disable.sh adds the names a list gained to the record before disabling them.
+        names = self.told_to_uncomment()
+        told = self.paragraph.split("uncomment", 1)[1].split("check.py", 1)[0]
+        self.assertIn("run Apply again", told, "only disable.sh records the uncommented lines for Undo")
+        lines = header(ANKER / "debloat.txt")
+        apply = next(line for line in lines if line.startswith("# Apply:"))
+        undo = next(line for line in lines if line.startswith("# Undo:"))
+        self.assertTrue(apply.endswith("tools/disable.sh examples/anker-nebula-mars-3-air/debloat.txt"))
+        self.assertTrue(undo.endswith(f"tools/restore.sh examples/anker-nebula-mars-3-air/debloat.txt "
+                                      f"{LAUNCHERX}"))
+
+        for script in ("disable.sh", "restore.sh"):
+            shutil.copy2(ROOT / "tools" / script, self.repo / "tools" / script)
+        # The scripts call tools/venv/bin/python: run the real interpreter, which imports the fake
+        # tv.py for the transport and the real recovery.py for the logic.
+        client = self.repo / "tools" / "venv" / "bin" / "python"
+        client.parent.mkdir(parents=True)
+        client.write_text(f'#!/bin/sh\nexec "{sys.executable}" "$@"\n')
+        client.chmod(0o755)
+
+        # The first Apply, of the shipped list: the new launcher is Home and nothing listed is off yet.
+        self.list_path.write_text(self.text, encoding="utf-8")
+        listed = recovery.read_list(self.list_path)
+        self.tv(installed=listed + list(ASSISTANT) + [drift.CUSTOM], disabled=[],
+                home=f"{drift.CUSTOM}/.MainActivity",
+                home_activities=[f"{drift.CUSTOM}/.MainActivity", f"{LAUNCHERX}/.MainActivity"])
+        result = self.run_script("disable.sh", str(self.list_path))
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        self.assertFalse(any(name in command for command in self.sent() for name in ASSISTANT))
+
+        # Later the owner wants Assistant off: uncomment the two lines and run Apply again.
+        self.list_path.write_text(self.uncommented(names), encoding="utf-8")
+        result = self.run_script("disable.sh", str(self.list_path))
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        self.assertIn("added 2 names the list gained since then", result.stdout)
+        applied = self.sent()
+        for name in ASSISTANT:
+            self.assertIn(f"pm disable-user --user 0 {name}", applied)
+
+        # Undo, as the header's Undo line runs it.
+        result = self.run_script("restore.sh", str(self.list_path), LAUNCHERX)
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        self.assertNotIn("not in the record", result.stderr)
+        undone = self.sent()[len(applied):]
+        for name in ASSISTANT:
+            self.assertIn(f"pm enable {name}", undone)
+
+    def test_the_shipped_list_leaves_assistant_on(self):
+        # The owner keeps it on so the mic button works: the fix is to the words, not the list.
+        self.put_list(self.text)
+        result = self.run_check("--fix", str(self.list_path))
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        self.assertIn("nothing drifted", result.stdout)
+        self.assertEqual(self.sent(), [])
+
+    def test_the_readme_row_says_the_same(self):
+        readme = (ANKER / "README.md").read_text(encoding="utf-8")
+        row = next(line for line in readme.splitlines() if line.startswith("| **Back after every boot**"))
+        self.assertIn("check.py --fix", row)
+        self.assertIn("uncomment", row)
+        for name in ASSISTANT:
+            self.assertIn(name, row)
+        # The run that records them for Undo comes before check.py --fix, as in the header.
+        told = row.split("uncomment", 1)[1].split("check.py", 1)[0]
+        self.assertIn("tools/disable.sh", told)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_list_troubleshooting_pointers.py b/tests/test_list_troubleshooting_pointers.py
new file mode 100644
index 00000000..d183a562
--- /dev/null
+++ b/tests/test_list_troubleshooting_pointers.py
@@ -0,0 +1,107 @@
+"""A list header that sends the reader to a fix names the page the fix is on.
+
+The README's "Gotchas we hit", later its "Troubleshooting" section, moved to docs/TROUBLESHOOTING.md on
+19 October 2026 (c49561eb). Seven list headers still said "(README, Troubleshooting)", "(see README
+gotchas)" or "See the README troubleshooting section", among them examples/xiaomi-mi-tv-4a, the list
+CONTRIBUTING.md and docs/workflows/tv-list.md tell contributors to copy. The README has no such heading
+any more, so the reader searches the front page and finds "When something goes wrong" with three
+bullets. The pairing recipe and the keyboard fix are not among them, and the setupwraith bullet is a
+summary that sends the reader on to docs/TROUBLESHOOTING.md.
+
+The sweep reads every page and list under examples/, with a list's `#` comment wraps joined, and lets a
+README section through only when the README still has a heading of that name. The table names the
+bullet each of those seven headers points at now, and the bullet has to start that way in the doc.
+
+Run from the repository root: python3 -m unittest discover -s tests -v
+"""
+import os
+import re
+import unittest
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+EXAMPLES = ROOT / "examples"
+README = (ROOT / "README.md").read_text(encoding="utf-8")
+DOC = (ROOT / "docs" / "TROUBLESHOOTING.md").read_text(encoding="utf-8")
+
+# "README, Troubleshooting", "README Troubleshooting", "the README troubleshooting section",
+# "README's Troubleshooting", "README gotchas".
+README_SECTION = re.compile(r"\bREADME(?:'s)?,?\s+(troubleshooting|gotchas)\b", re.I)
+# A list wraps its header at about 105 columns, and a pointer can be cut anywhere in it.
+COMMENT_WRAP = re.compile(r"\s*\n#\s*")
+FENCE = re.compile(r"```.*?```", re.S)
+
+# Folder -> the bullet in docs/TROUBLESHOOTING.md its header names, as `docs/TROUBLESHOOTING.md, "..."`.
+POINTERS = {
+    "google-tv-streamer-4k-kirkwood": "USB debugging never opens port 5555",
+    "google-chromecast-gtv-4k": "USB debugging never opens port 5555",
+    "tcl-qm6k-google-tv": "USB debugging never opens port 5555",
+    "tcl-g05-google-tv": "The new launcher still doesn't own Home",
+    "tcl-55s470g": "The new launcher still doesn't own Home",
+    "xiaomi-mitv-moor2": "The new launcher still doesn't own Home",
+    "xiaomi-mi-tv-4a": "No on-screen keyboard",
+}
+
+
+def joined(text):
+    """A list's text with its `#` comment wraps joined into one line, as a reader reads it."""
+    return COMMENT_WRAP.sub(" ", text)
+
+
+def readme_headings():
+    return [h.lower() for h in re.findall(r"^#+\s+(.+)$", FENCE.sub("", README), re.M)]
+
+
+def pages(root):
+    """(relative path, text) for every list and page under root, in a stable order."""
+    for directory, subdirectories, files in os.walk(root):
+        subdirectories.sort()
+        for name in sorted(files):
+            if name.endswith((".txt", ".md")):
+                path = Path(directory) / name
+                yield path.relative_to(ROOT), path.read_text(encoding="utf-8", errors="replace")
+
+
+def missing_sections(root, headings):
+    """(file, pointer) for every README section named under root that headings do not have."""
+    found = []
+    for path, text in pages(root):
+        for match in README_SECTION.finditer(joined(text)):
+            if not any(match.group(1).lower() in heading for heading in headings):
+                found.append((str(path), match.group(0)))
+    return found
+
+
+class ListTroubleshootingPointersTest(unittest.TestCase):
+    def test_the_pattern_reads_every_spelling_the_lists_used(self):
+        for text in ("works on 5555 (README, Troubleshooting).", "installed (see README Troubleshooting).",
+                     "See the README troubleshooting section.", "Set Gboard as the IME (see README gotchas).",
+                     "the README's Troubleshooting has it"):
+            with self.subTest(text=text):
+                self.assertRegex(text, README_SECTION)
+        for text in ('(docs/TROUBLESHOOTING.md, "No on-screen keyboard")', "Steps in the README FAQ.",
+                     "see launcher Troubleshooting #3"):
+            with self.subTest(text=text):
+                self.assertNotRegex(text, README_SECTION)
+
+    def test_a_pointer_cut_by_a_comment_wrap_is_still_read(self):
+        text = "# installed, so no keyboard appears. Set Gboard as the IME (see README\n#   gotchas).\n"
+        self.assertRegex(joined(text), README_SECTION)
+
+    def test_no_page_in_examples_names_a_readme_section_the_readme_does_not_have(self):
+        self.assertEqual(missing_sections(EXAMPLES, readme_headings()), [],
+                         "the section moved to docs/TROUBLESHOOTING.md: name the bullet there")
+
+    def test_each_header_names_the_bullet_the_fix_is_in(self):
+        for folder, lead in POINTERS.items():
+            with self.subTest(folder=folder):
+                self.assertTrue(re.search(r"^- \*\*" + re.escape(lead), DOC, re.M),
+                                f"no bullet in docs/TROUBLESHOOTING.md starts with {lead!r}")
+                pointer = f'docs/TROUBLESHOOTING.md, "{lead}"'
+                header = joined((EXAMPLES / folder / "debloat.txt").read_text(encoding="utf-8"))
+                self.assertTrue(pointer in header, f"the header does not name {pointer}")
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_lumio_connected_wifi_check.py b/tests/test_lumio_connected_wifi_check.py
new file mode 100644
index 00000000..eb34037a
--- /dev/null
+++ b/tests/test_lumio_connected_wifi_check.py
@@ -0,0 +1,129 @@
+"""The Lumio Vision 7 notes give a Wi-Fi check that shows which saved network is in use.
+
+On the contributor's unit setupwraith owned one saved network, but the network in use was system-owned, so
+`FORCE_SETUPWRAITH=1` was safe there. The README and the list header tell other units to add the override only
+once the network they are connected to is system-owned. `dumpsys wifi | grep -o 'cname=[^ ]*'` cannot tell them:
+it prints one bare owner per saved network, with no SSID and no connected flag, so a unit whose network in use
+belongs to setupwraith prints the same two lines as the contributor's. The check has to pair each entry's
+`Currently Connected:` flag with its owner (examples/xgimi-mogo-4/README.md reads the same flag).
+
+The README's command is run here, as grep would run it, against a `dumpsys wifi` excerpt shaped like the one a
+Chromecast with Google TV 4K (Google TV 14) prints, with made-up network names.
+
+Run from the repository root: python3 -m unittest discover -s tests -v
+"""
+from pathlib import Path
+import re
+import sys
+import unittest
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from test_apply_override_caveat import OVERRIDE, apply_blocks  # noqa: E402
+
+
+ROOT = Path(__file__).resolve().parents[1]
+FOLDER = ROOT / "examples" / "lumio-vision-7"
+README = (FOLDER / "README.md").read_text(encoding="utf-8")
+LIST = (FOLDER / "debloat.txt").read_text(encoding="utf-8")
+SETUP = "com.google.android.tungsten.setupwraith"
+SYSTEM = "android.uid.system:1000"
+
+# `tools/tv.py "dumpsys wifi | grep -o 'PATTERN'"` or `grep -oE`.
+CHECK = re.compile(r'tools/tv\.py "dumpsys wifi \| grep -oE? \'([^\']+)\'"')
+
+
+def network(number, name, connected, owner, uid):
+    """One saved network as WifiConfigManager dumps it: the ID line first, the creator further down."""
+    mark = "* " if connected else ""
+    return (
+        f'{mark}ID: {number} SSID: "{name}" PROVIDER-NAME: null BSSID: null FQDN:  HOME-PROVIDER-NETWORK: false '
+        f"PRIO: 0 HIDDEN: false PMF: false CarrierId: -1 SubscriptionId: -1 SubscriptionGroup: null "
+        f"Currently Connected: {'true' if connected else 'false'} User Selected: false\n"
+        " NetworkSelectionStatus NETWORK_SELECTION_ENABLED\n"
+        " KeyMgmt: WPA_PSK Protocols: WPA RSN\n"
+        f" cuid={uid} cname={owner} luid={uid} lname={owner}\n"
+    )
+
+
+def dumpsys(home_connected):
+    """A system-owned home network and a setupwraith-owned one; `home_connected` says which is in use."""
+    return (
+        "WifiConfigManager - Configured networks Begin ----\n"
+        + network(0, "Home", home_connected, SYSTEM, 1000)
+        + network(1, "Hotspot", not home_connected, SETUP, 10031)
+        + "WifiConfigManager - Configured networks End ----\n"
+    )
+
+
+def grep_o(pattern, text):
+    """What `grep -o` (or `grep -oE`) prints: every match, line by line, in order."""
+    return [m.group(0) for line in text.splitlines() for m in re.finditer(pattern, line)]
+
+
+def owner_in_use(output):
+    """The `cname=` that follows `Currently Connected: true` in the check's output, or None."""
+    for flag, owner in zip(output, output[1:]):
+        if flag == "Currently Connected: true" and owner.startswith("cname="):
+            return owner[len("cname="):]
+    return None
+
+
+def setupwraith_section():
+    parts = re.split(r"(?m)^## ", README)
+    matches = [p for p in parts[1:] if "setupwraith" in p.split("\n", 1)[0]]
+    assert len(matches) == 1, f"expected one README section about setupwraith, found {len(matches)}"
+    return matches[0]
+
+
+def header():
+    return "\n".join(line for line in LIST.splitlines() if line.startswith("#"))
+
+
+class LumioConnectedWifiCheckTest(unittest.TestCase):
+    def setUp(self):
+        self.patterns = CHECK.findall(setupwraith_section())
+
+    def test_the_readme_gives_a_wifi_check(self):
+        self.assertTrue(self.patterns, "the setupwraith section gives no `tools/tv.py \"dumpsys wifi | grep ...\"` check")
+
+    def test_the_bare_owner_list_cannot_tell_which_network_is_in_use(self):
+        # Why the check needs more than the owners: both units print the same lines.
+        bare = "cname=[^ ]*"
+        self.assertEqual(grep_o(bare, dumpsys(True)), grep_o(bare, dumpsys(False)))
+
+    def test_every_check_in_the_readme_names_the_owner_of_the_network_in_use(self):
+        for pattern in self.patterns:
+            with self.subTest(pattern=pattern):
+                self.assertEqual(SYSTEM, owner_in_use(grep_o(pattern, dumpsys(True))),
+                                 "on the contributor's unit the check must show the system-owned network in use")
+                self.assertEqual(SETUP, owner_in_use(grep_o(pattern, dumpsys(False))),
+                                 "on a unit on setupwraith's network the check must show setupwraith in use")
+
+    def test_the_check_prints_no_network_names(self):
+        # Owners post their output in issues; the check should not carry the SSIDs along.
+        for pattern in self.patterns:
+            with self.subTest(pattern=pattern):
+                output = "\n".join(grep_o(pattern, dumpsys(True)))
+                self.assertNotIn("Home", output)
+                self.assertNotIn("Hotspot", output)
+
+    def test_the_override_stays_tied_to_ethernet_or_a_system_owned_connection(self):
+        text = re.sub(r"\s+", " ", setupwraith_section())
+        self.assertIn("only on Ethernet", text)
+        self.assertIn("`android.uid.system`", text)
+        self.assertIn("Currently Connected: true", text)
+
+    def test_the_header_points_to_the_connected_network_check(self):
+        text = re.sub(r"#\s*", " ", header())
+        text = re.sub(r"\s+", " ", text)
+        self.assertIn("Currently Connected", text)
+        self.assertIn("network in use", text)
+
+    def test_the_apply_line_still_leaves_the_override_out(self):
+        blocks = apply_blocks(LIST)
+        self.assertEqual(1, len(blocks))
+        self.assertIsNone(OVERRIDE.search(" ".join(blocks[0][1])))
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_manage_set.py b/tests/test_manage_set.py
new file mode 100644
index 00000000..965f5bd4
--- /dev/null
+++ b/tests/test_manage_set.py
@@ -0,0 +1,211 @@
+"""tools/manage.py set writes a value the launcher will read, or refuses one it would drop.
+
+Every reader in Config.java is strict about the JSON type: bool() takes a Boolean and nothing else, string() a
+String, integer() a Number in its range, the list readers an array. A value of another type is not an error
+there - the built-in default comes back - so `set dock_band 3` used to write 3, print "dock_band = 3", push the
+theme and leave the switch at its default on the TV. The type of every key is in the Keys table of
+themes/README.md, so set reads the argument the way that table says and refuses the rest before it writes.
+"""
+import json
+import re
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+from unittest import mock
+
+ROOT = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(ROOT / "tools"))
+import manage  # noqa: E402
+
+
+def keys_table_types():
+    """The type cell of every key in themes/README.md's Keys table, read the way manage.switches() reads it."""
+    text = (ROOT / "themes" / "README.md").read_text(encoding="utf-8")
+    part = text[text.index("## Keys"):]
+    out = {}
+    for row in manage.table_rows(part, "| Key |"):
+        for key in re.findall(r"`([a-z_]+)`", row[0]):
+            out[key] = manage.plain(row[1]) if len(row) > 1 else ""
+    return out
+
+
+class SetValueTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.theme = Path(self.tmp.name) / "my-theme"
+        self.theme.mkdir()
+        self.config = self.theme / "config.json"
+        # cmd_set ends by pushing the theme with tools/theme.sh; the tests stop before the TV.
+        patcher = mock.patch.object(manage, "run")
+        self.push = patcher.start()
+        self.addCleanup(patcher.stop)
+
+    def set_key(self, key, value):
+        """Runs set the way main() does; returns the refusal text, or None when the value was written."""
+        try:
+            with mock.patch("sys.stdout"):
+                manage.cmd_set(key, value, str(self.theme))
+        except SystemExit as stop:
+            return str(stop.code)
+        return None
+
+    def written(self):
+        return json.loads(self.config.read_text(encoding="utf-8")) if self.config.is_file() else None
+
+    def test_a_bool_key_refuses_a_number_before_anything_is_written(self):
+        self.config.write_text('{"greeting_name": "Old"}\n', encoding="utf-8")
+        before = self.config.read_bytes()
+        refusal = self.set_key("dock_band", "3")
+        self.assertIn("dock_band", refusal)
+        self.assertIn("true or false", refusal)
+        self.assertIn("3", refusal)
+        self.assertEqual(before, self.config.read_bytes(), "a refused value must not touch the theme")
+        self.push.assert_not_called()
+
+    def test_a_bool_key_takes_true_and_false(self):
+        for text, expected in (("true", True), ("false", False), ("True", True)):
+            with self.subTest(value=text):
+                self.assertIsNone(self.set_key("dock_band", text))
+                self.assertIs(self.written()["dock_band"], expected)
+                self.assertIsInstance(self.written()["dock_band"], bool)
+
+    def test_a_list_key_refuses_a_bare_package_name(self):
+        # The shape a reader types by hand: one package where the launcher wants an array.
+        refusal = self.set_key("dock_apps", "com.example.player")
+        self.assertIn("dock_apps", refusal)
+        self.assertIn("list of package names", refusal)
+        self.assertIn('["a", "b"]', refusal)
+        self.assertIsNone(self.written())
+        self.push.assert_not_called()
+
+    def test_a_list_key_takes_a_json_list(self):
+        self.assertIsNone(self.set_key("dock_apps", '["com.example.player", "com.example.tv"]'))
+        self.assertEqual(["com.example.player", "com.example.tv"], self.written()["dock_apps"])
+
+    def test_a_number_key_refuses_text_and_takes_a_number(self):
+        refusal = self.set_key("columns", "six")
+        self.assertIn("columns", refusal)
+        self.assertIn("1 to 8", refusal)
+        self.assertIsNone(self.written())
+        self.assertIsNone(self.set_key("columns", "6"))
+        self.assertEqual(6, self.written()["columns"])
+
+    def test_a_number_key_refuses_true(self):
+        # Python reads True as an int; the launcher's integer() does not, so the value would be dropped.
+        refusal = self.set_key("columns", "true")
+        self.assertIn("columns", refusal)
+        self.assertIsNone(self.written())
+
+    def test_a_number_key_refuses_a_value_outside_the_tables_range(self):
+        # integer() keeps its own default for a number outside min..max, so set must not write one either.
+        for key, value in (("columns", "9"), ("columns", "0"), ("rows_below_dock", "4"),
+                           ("sky_intensity", "101"), ("clock_wallpaper_dim", "91"), ("dock_opacity", "29")):
+            with self.subTest(key=key, value=value):
+                self.config.unlink(missing_ok=True)
+                refusal = self.set_key(key, value)
+                self.assertIn(key, refusal)
+                self.assertIn("out of range", refusal)
+                self.assertIn(value, refusal)
+                self.assertIsNone(self.written(), "a refused value must not touch the theme")
+                self.push.assert_not_called()
+
+    def test_a_number_key_takes_both_ends_of_its_range(self):
+        # The bounds are read out of the Keys table, so a range that moves there moves here with it.
+        numbers = {k: v for k, v in keys_table_types().items() if manage.declared_kind({"type": v}) == "number"}
+        self.assertGreaterEqual(len(numbers), 10, "the Keys table's number keys were read")
+        for key, cell in sorted(numbers.items()):
+            low, high = manage.declared_range(cell)
+            with self.subTest(key=key, value=low):
+                self.config.unlink(missing_ok=True)
+                self.assertIsNone(self.set_key(key, str(low)))
+                self.assertEqual(low, self.written()[key])
+            with self.subTest(key=key, value=high):
+                self.assertIsNone(self.set_key(key, str(high)))
+                self.assertEqual(high, self.written()[key])
+
+    def test_a_number_key_writes_the_int_the_launcher_would_read(self):
+        # integer() does ((Number) v).intValue(), so 8.9 is eight columns on the TV: write 8, not 8.9.
+        self.assertIsNone(self.set_key("columns", "8.9"))
+        self.assertEqual(8, self.written()["columns"])
+        self.assertIsInstance(self.written()["columns"], int)
+
+    def test_a_number_key_refuses_nan_and_infinity(self):
+        # json.loads accepts these three; intValue() has no answer for them, so the key keeps its default.
+        for text in ("NaN", "Infinity", "-Infinity"):
+            with self.subTest(value=text):
+                self.config.unlink(missing_ok=True)
+                self.assertIn("finite", self.set_key("columns", text))
+                self.assertIsNone(self.written())
+                self.push.assert_not_called()
+
+    def test_a_range_cell_is_read_as_its_two_bounds(self):
+        self.assertEqual((1, 8), manage.declared_range("1 to 8"))
+        self.assertEqual((30, 100), manage.declared_range("30 to 100"))
+        self.assertEqual((None, None), manage.declared_range("bool"))
+        self.assertEqual((None, None), manage.declared_range("1 to 8 if top_menu"))
+
+    def test_an_object_key_refuses_a_word_and_takes_a_json_object(self):
+        refusal = self.set_key("wallpaper_moods", "nope")
+        self.assertIn("wallpaper_moods", refusal)
+        self.assertIn("object", refusal)
+        self.assertIsNone(self.written())
+        self.assertIsNone(self.set_key("wallpaper_moods", '{"morning": "a.jpg"}'))
+        self.assertEqual({"morning": "a.jpg"}, self.written()["wallpaper_moods"])
+
+    def test_a_string_key_takes_a_number_as_its_text(self):
+        # string() takes a String only, so a number here would leave the key at its default.
+        self.assertIsNone(self.set_key("greeting_name", "42"))
+        self.assertEqual("42", self.written()["greeting_name"])
+
+    def test_a_string_key_keeps_a_quoted_value_working(self):
+        self.assertIsNone(self.set_key("greeting_name", '"Good evening"'))
+        self.assertEqual("Good evening", self.written()["greeting_name"])
+
+    def test_a_key_the_launcher_never_reads_from_a_theme_is_refused(self):
+        # The table's own words for this one: "list, config.xml only" ... "Not read from a theme". (input_sources
+        # was one too, until #1655 let a theme set it.)
+        for key in ("settings_fallback_components",):
+            with self.subTest(key=key):
+                refusal = self.set_key(key, '["a/b"]')
+                self.assertIn(key, refusal)
+                self.assertIn("config.xml", refusal)
+                self.assertIsNone(self.written())
+                self.push.assert_not_called()
+
+    def test_an_unknown_key_is_still_refused_by_name(self):
+        self.assertIn("no switch called", self.set_key("no_such_key", "1"))
+
+    def test_the_kind_of_every_key_comes_from_the_keys_table(self):
+        types = keys_table_types()
+        self.assertGreater(len(types), 90, "the Keys table was read")
+        self.assertEqual("bool", manage.declared_kind(manage.find("dock_band")))
+        self.assertEqual("list", manage.declared_kind(manage.find("dock_apps")))
+        self.assertEqual("number", manage.declared_kind(manage.find("columns")))
+        self.assertEqual("object", manage.declared_kind(manage.find("wallpaper_moods")))
+        self.assertEqual("string", manage.declared_kind(manage.find("greeting_name")))
+        self.assertEqual("config-only", manage.declared_kind(manage.find("settings_fallback_components")))
+        self.assertEqual("list", manage.declared_kind(manage.find("input_sources")))
+        # A type cell this file does not recognise would fall through to "string" and let a wrong value
+        # through, so every cell the table carries today has to land on a kind.
+        known = {"bool", "list", "number", "object", "string", "config-only"}
+        for cell in sorted(set(types.values())):
+            with self.subTest(cell=cell):
+                self.assertIn(manage.declared_kind({"type": cell}), known)
+
+    def test_the_readers_it_copies_are_still_strict(self):
+        """A launcher that started coercing types would make set's refusals wrong, so pin the readers."""
+        config = (ROOT / "launcher/app/src/main/java/com/gathin/tvhome/Config.java").read_text(encoding="utf-8")
+        self.assertIn("Object v = o.opt(key);", config)
+        self.assertIn("return v instanceof Boolean ? (Boolean) v : fallback;", config)
+        self.assertIn('return v instanceof String ? ((String) v).trim() : fallback;', config)
+        self.assertIn("if (!(v instanceof Number)) return fallback;", config)
+        # integer() truncates like Number.intValue() and keeps its default outside min..max: the two rules
+        # set's number handling copies.
+        self.assertIn("int i = ((Number) v).intValue();", config)
+        self.assertIn("return i < min || i > max ? fallback : i;", config)
+
+
+if __name__ == "__main__":
+    unittest.main()
