@@ -0,0 +1,25 @@
+package com.gathin.tvhome;
+
+import static org.junit.Assert.assertEquals;
+
+import org.junit.Test;
+
+public class SleepTimerTest {
+    @Test
+    public void eachPressMovesToTheNextStep() {
+        assertEquals(15, SleepTimer.nextStep(0));
+        assertEquals(30, SleepTimer.nextStep(15));
+        assertEquals(30, SleepTimer.nextStep(14));
+        assertEquals(60, SleepTimer.nextStep(30));
+        assertEquals(90, SleepTimer.nextStep(60));
+        assertEquals(0, SleepTimer.nextStep(90));
+    }
+
+    @Test
+    public void minutesLeftRoundUpAndEndAtZero() {
+        assertEquals(0, SleepTimer.minutesLeft(0, 1_000));
+        assertEquals(0, SleepTimer.minutesLeft(1_000, 1_000));
+        assertEquals(1, SleepTimer.minutesLeft(61_000, 60_000));
+        assertEquals(15, SleepTimer.minutesLeft(15 * 60_000L, 0));
+    }
+}
diff --git a/tests/test_adb_key_fallback.py b/tests/test_adb_key_fallback.py
