@@ -0,0 +1,22 @@
+package com.gathin.tvhome;
+
+import android.app.Activity;
+import android.os.Bundle;
+
+/**
+ * CleanTV/VGS: opens a link tile (a TV channel) as the Open on start app (feedback daotrunghieu3010, 02/11/2026: power on
+ * straight into a channel, not the app's start screen). OpenOnStart.intent hands out an intent for this activity, so
+ * every caller that starts an app at power-on or wake starts a channel the same way; it opens the link and goes away.
+ */
+public final class LinkOpenActivity extends Activity {
+    static final String EXTRA_TILE = "tile";
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        String pkg = getIntent().getStringExtra(EXTRA_TILE);
+        LinkTiles.Link l = pkg == null ? null : LinkTiles.find(this, pkg);
+        if (l != null) LinkTiles.open(this, l.uri, l.target);
+        finish();
+    }
+}
diff --git a/launcher/app/src/main/java/com/gathin/tvhome/LinkTiles.java b/launcher/app/src/main/java/com/gathin/tvhome/LinkTiles.java
