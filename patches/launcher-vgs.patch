+        new QuoteItem("Cuộc đời như một tấm gương, bạn mỉm cười với nó thì nó sẽ mỉm cười lại với bạn.", "Danh ngôn")
+    };
+
+    private static final Random RANDOM = new Random();
+
+    /**
+     * Lấy một câu cố định trong ngày (mỗi ngày một câu khác nhau).
+     */
+    public static QuoteItem getTodayQuote() {
+        Calendar cal = Calendar.getInstance();
+        int dayOfYear = cal.get(Calendar.DAY_OF_YEAR);
+        int idx = Math.abs(dayOfYear) % QUOTES.length;
+        return QUOTES[idx];
+    }
+
+    /**
+     * CleanTV/VGS: Lấy câu danh ngôn theo khung 2 giờ trong ngày (đổi 2h một lần).
+     * 1 ngày có 12 khung giờ (0h-2h, 2h-4h, ...). Kết hợp với ngày trong năm để mỗi khung 2h là một câu khác nhau.
+     */
+    public static QuoteItem getTwoHourQuote(int offset) {
+        Calendar cal = Calendar.getInstance();
+        int slot = cal.get(Calendar.DAY_OF_YEAR) * 12 + (cal.get(Calendar.HOUR_OF_DAY) / 2) + offset;
+        return QUOTES[Math.floorMod(slot, QUOTES.length)];
+    }
+
+    /**
+     * Lấy ngẫu nhiên một câu.
+     */
+    public static QuoteItem getRandomQuote() {
+        return QUOTES[RANDOM.nextInt(QUOTES.length)];
+    }
+
+    /**
+     * Lấy câu tiếp theo theo chỉ số xoay vòng.
+     */
+    public static QuoteItem getNextQuote(int index) {
+        int idx = Math.floorMod(index, QUOTES.length);
+        return QUOTES[idx];
+    }
+
+    public static int getCount() {
+        return QUOTES.length;
+    }
+}
