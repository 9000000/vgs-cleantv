diff --git a/launcher/app/src/test/java/com/gathin/tvhome/FamilyFeaturesTest.java b/launcher/app/src/test/java/com/gathin/tvhome/FamilyFeaturesTest.java
new file mode 100644
index 00000000..65e6f4a2
--- /dev/null
+++ b/launcher/app/src/test/java/com/gathin/tvhome/FamilyFeaturesTest.java
@@ -0,0 +1,57 @@
+package com.gathin.tvhome;
+
+import org.junit.Test;
+
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertTrue;
+
+/**
+ * Unit tests for family features (EventsTracker, QuotesProvider, HistoryProvider).
+ */
+public class FamilyFeaturesTest {
+
+    @Test
+    public void testEventsTrackerTetCountdown() {
+        EventsTracker.EventInfo tet = EventsTracker.countdownTet();
+        assertNotNull("Tet event should not be null", tet);
+        assertTrue("Days remaining should be non-negative", tet.daysRemaining >= 0);
+        assertTrue("Days remaining should be within 385 days", tet.daysRemaining <= 385);
+        assertTrue("Title should contain Tết", tet.title.contains("Tết"));
+        assertNotNull("Formatted string should not be null", tet.formatted);
+        assertFalse("Formatted string should not be empty", tet.formatted.isEmpty());
+    }
+
+    @Test
+    public void testEventsTrackerNearestEvent() {
+        EventsTracker.EventInfo nearest = EventsTracker.getNearestEvent();
+        assertNotNull("Nearest event should not be null", nearest);
+        assertTrue("Days remaining should be non-negative", nearest.daysRemaining >= 0);
+        assertFalse("Formatted text should not be empty", nearest.formatted.isEmpty());
+    }
+
+    @Test
+    public void testQuotesProvider() {
+        assertTrue("Quote count should be at least 30", QuotesProvider.getCount() >= 30);
+        QuotesProvider.QuoteItem today = QuotesProvider.getTodayQuote();
+        assertNotNull("Today quote should not be null", today);
+        assertFalse("Today quote text should not be empty", today.text.isEmpty());
+        assertFalse("Today quote author should not be empty", today.author.isEmpty());
+
+        QuotesProvider.QuoteItem random = QuotesProvider.getRandomQuote();
+        assertNotNull("Random quote should not be null", random);
+
+        QuotesProvider.QuoteItem next = QuotesProvider.getNextQuote(5);
+        assertNotNull("Next quote should not be null", next);
+        assertTrue("Formatted quote should have quotes", next.getFormatted().contains("“"));
+    }
+
+    @Test
+    public void testHistoryProviderFallback() {
+        HistoryProvider.HistoryItem item = HistoryProvider.getItemAt(0);
+        // Cached might be null before loading, but we test getItemAt doesn't throw
+        if (item != null) {
+            assertNotNull(item.getFormatted());
+        }
+    }
+}
diff --git a/launcher/app/src/test/java/com/gathin/tvhome/LunarTest.java b/launcher/app/src/test/java/com/gathin/tvhome/LunarTest.java
index d88390cd..3ff28a84 100644
--- a/launcher/app/src/test/java/com/gathin/tvhome/LunarTest.java
+++ b/launcher/app/src/test/java/com/gathin/tvhome/LunarTest.java
@@ -61,4 +61,22 @@ public class LunarTest {
         assertArrayEquals(new int[]{1, 1, 1985, 0}, Lunar.fromSolar(21, 1, 1985, 7));
         assertArrayEquals(new int[]{1, 1, 1985, 0}, Lunar.fromSolar(20, 2, 1985, 8));
     }
+
+    @Test
+    public void dayStemAndBranch() {
+        // 1/1/2024 is Giap Ty
+        long jd1 = Lunar.jdFromDate(1, 1, 2024);
+        org.junit.Assert.assertEquals(0, Math.floorMod(jd1 + 9, 10)); // Giap
+        org.junit.Assert.assertEquals(0, Math.floorMod(jd1 + 1, 12)); // Ty
+
+        // 10/2/2024 (Tet Giap Thin) is Giap Thin
+        long jd2 = Lunar.jdFromDate(10, 2, 2024);
+        org.junit.Assert.assertEquals(0, Math.floorMod(jd2 + 9, 10)); // Giap
+        org.junit.Assert.assertEquals(4, Math.floorMod(jd2 + 1, 12)); // Thin
+
+        // 26/10/2026 is Quy Dau
+        long jd3 = Lunar.jdFromDate(26, 10, 2026);
+        org.junit.Assert.assertEquals(9, Math.floorMod(jd3 + 9, 10)); // Quy
+        org.junit.Assert.assertEquals(9, Math.floorMod(jd3 + 1, 12)); // Dau
+    }
 }
