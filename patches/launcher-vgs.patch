+"""tools/gen_tables.py refuses a path it cannot read instead of dying in a traceback, the way it refuses a font.
+
+Exit 1 is what main's "README tables" job reads as "the tables are out of date", so the run that never read a
+byte must not come back as 1: `--root` on a folder that is not a checkout, and `--adopt` on a patch that is not
+there, both ended in a FileNotFoundError traceback - exit 1 - before, which is the same answer a stale README.md
+gives. The script's own docstring names 2 for "what it was given cannot be read", and `--font` on a path that is
+not there already exits 2 through ap.error, so this is one rule applied to its other two paths.
+
+Every test runs the real script in a subprocess, since the exit status and the line on stderr are what a
+maintainer sees; the trees come from tests/test_gen_tables.py, so a valid checkout is built the same way there.
+
+Run from the repository root: python3 -m unittest discover -s tests -v
+"""
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "tests"))
+sys.path.insert(0, str(ROOT / "tools"))
+from test_gen_tables import add, tree, tv  # noqa: E402  (the small checkout the other gen_tables tests use)
+
+SCRIPT = ROOT / "tools" / "gen_tables.py"
+
+
+def run(*args, cwd=None):
+    """(exit status, stdout, stderr) of the real script."""
+    done = subprocess.run([sys.executable, str(SCRIPT), *args], cwd=cwd, capture_output=True, text=True)
+    return done.returncode, done.stdout, done.stderr
+
+
+def valid(tmp):
+    """The small checkout tests/test_gen_tables.py builds: examples/ with two folders and the three files."""
+    return tree(tmp, [("tcl-a", tv("TCL A", "TCL")), ("sony-b", tv("Sony B", "Sony"))])
+
+
+class RootTest(unittest.TestCase):
+    def test_a_root_that_is_not_a_folder_exits_2(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp) / "nope"
+            code, out, err = run("--root", str(root), "--check")
+            self.assertEqual(code, 2, err)
+            self.assertIn("not a folder", err)
+            self.assertIn(str(root), err)
+            self.assertNotIn("Traceback", err)
+            self.assertEqual(out, "")
+
+    def test_a_root_that_is_a_file_exits_2(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = Path(tmp) / "README.md"
+            path.write_text("# not a checkout\n", encoding="utf-8")
+            code, out, err = run("--root", str(path), "--check")
+            self.assertEqual(code, 2, err)
+            self.assertIn("not a folder", err)
+            self.assertEqual(out, "")
+
+    def test_the_root_it_could_not_read_is_quoted(self):
+        # Quoted, so the line shows the path it was handed even when that token is empty or has spaces in it.
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp) / "no such checkout"
+            code, _, err = run("--root", str(root), "--check")
+            self.assertEqual(code, 2, err)
+            self.assertIn(f"--root '{root}'", err)
+
+    def test_a_folder_that_is_not_a_checkout_names_what_is_missing(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp) / "empty"
+            root.mkdir()
+            code, out, err = run("--root", str(root), "--check")
+            self.assertEqual(code, 2, err)
+            for name in ("examples/", "README.md", "examples/README.md", "tools/readme_stats.py"):
+                with self.subTest(missing=name):
+                    self.assertIn(name, err)
+            self.assertEqual(out, "")
+
+    def test_one_missing_file_is_named_and_the_others_are_not(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root = valid(tmp)
+            (root / "tools" / "readme_stats.py").unlink()
+            code, out, err = run("--root", str(root), "--check")
+            self.assertEqual(code, 2, err)
+            self.assertIn("no tools/readme_stats.py in it", err)
+            # The other four paths must not be named as missing: pin the phrase, not a bare "examples/",
+            # since the line also carries the root, whose path a runner could one day spell with it.
+            self.assertNotIn("no examples/", err)
+
+    def test_a_refused_root_is_never_the_out_of_date_exit(self):
+        # The one thing a weekly job and the README-tables job both read as a real finding.
+        with tempfile.TemporaryDirectory() as tmp:
+            (Path(tmp) / "repo").mkdir()
+            code, _, err = run("--root", str(Path(tmp) / "repo"), "--check")
+            self.assertNotEqual(code, 1, err)
+            self.assertEqual(code, 2)
+
+    def test_a_refused_root_writes_nothing(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root = valid(tmp)
+            # A tree whose tables are stale: a run that got as far as render() would rewrite README.md.
+            add(root, "tcl-c", tv("TCL C", "TCL"))
+            before = (root / "README.md").read_bytes()
+            (root / "examples" / "README.md").unlink()
+            code, _, err = run("--root", str(root))
+            self.assertEqual(code, 2, err)
+            self.assertEqual((root / "README.md").read_bytes(), before)
+
+
+class AdoptTest(unittest.TestCase):
+    def test_a_patch_that_is_not_there_exits_2(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root = valid(tmp)
+            patch = Path(tmp) / "pr.diff"
+            code, out, err = run("--root", str(root), "--adopt", str(patch))
+            self.assertEqual(code, 2, err)
+            self.assertIn(str(patch), err)
+            self.assertIn("No such file or directory", err)
+            self.assertIn("Nothing was written", err)
+            self.assertNotIn("Traceback", err)
+            self.assertEqual(out, "")
+
+    def test_a_patch_that_is_a_folder_exits_2(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root = valid(tmp)
+            code, out, err = run("--root", str(root), "--adopt", tmp)
+            self.assertEqual(code, 2, err)
+            self.assertIn("Is a directory", err)
+            self.assertIn("Nothing was written", err)
+            self.assertEqual(out, "")
+
+    def test_an_empty_patch_path_is_still_named_in_the_line(self):
+        # `--adopt ''` (or a stray pair of quotes) leaves the token empty: quoted, the line still shows what
+        # it tried to read instead of "cannot read : No such file or directory".
+        with tempfile.TemporaryDirectory() as tmp:
+            root = valid(tmp)
+            code, out, err = run("--root", str(root), "--adopt", "")
+            self.assertEqual(code, 2, err)
+            self.assertIn("cannot read ''", err)
+            self.assertIn("Nothing was written", err)
+            self.assertEqual(out, "")
+
+    def test_the_root_is_judged_before_the_patch_is_applied(self):
+        # A readable patch and a root with nothing of the repository in it: no tv.json may appear.
+        with tempfile.TemporaryDirectory() as tmp:
+            root = valid(tmp)
+            add(root, "tcl-d", None)  # a folder with a list and no tv.json: what --adopt exists to write
+            patch = Path(tmp) / "pr.diff"
+            patch.write_text("| `tcl-d/` | TCL D | Android TV 11 | ads off |\n", encoding="utf-8")
+            (root / "README.md").unlink()
+            code, out, err = run("--root", str(root), "--adopt", str(patch))
+            self.assertEqual(code, 2, err)
+            self.assertIn("README.md", err)
+            self.assertFalse((root / "examples" / "tcl-d" / "tv.json").exists(), "the patch was applied anyway")
+            self.assertEqual(out, "")
+
+
+class UnchangedTest(unittest.TestCase):
+    def test_a_checkout_exits_0_and_a_stale_one_still_1(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root = valid(tmp)
+            code, out, err = run("--root", str(root))
+            self.assertEqual(code, 0, err)
+            code, out, err = run("--root", str(root), "--check")
+            self.assertEqual(code, 0, err)
+            add(root, "tcl-c", tv("TCL C", "TCL"))
+            code, out, err = run("--root", str(root), "--check")
+            self.assertEqual(code, 1, err)
+            self.assertIn("Out of date", out)
+
+    def test_a_readable_patch_is_still_applied(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root = valid(tmp)
+            add(root, "tcl-d", None)
+            patch = Path(tmp) / "pr.diff"
+            patch.write_text("| `tcl-d/` | TCL D | Android TV 11 | ads off |\n", encoding="utf-8")
+            code, out, err = run("--root", str(root), "--adopt", str(patch))
+            self.assertEqual(code, 0, err)
+            self.assertIn("examples/tcl-d/tv.json", out)
+            self.assertTrue((root / "examples" / "tcl-d" / "tv.json").is_file())
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_haier_h50h5f_loop_note.py b/tests/test_haier_h50h5f_loop_note.py
new file mode 100644
index 00000000..384d2087
--- /dev/null
+++ b/tests/test_haier_h50h5f_loop_note.py
@@ -0,0 +1,116 @@
+"""The Haier H50H5F restart-loop bullet (#1578) must not present the attached list as the agent's work.
+
+The report attached the six files PROMPT.md has the agent save before changing anything, and the reply
+on the issue named eight packages from its disabled list. On the Haier-built AQUA MatrixTV EE 50, five of
+those eight are disabled from the factory, so the list may be the TV's state before the debloat. The
+bullet says so, keeps the way back that holds either way (the factory reset in the recovery menu), and
+does not tell the reader to turn the eight on as an undo.
+
+Run from the repository root: python3 -m unittest discover -s tests -v
+"""
+from pathlib import Path
+import re
+import unittest
+
+
+ROOT = Path(__file__).resolve().parents[1]
+TROUBLE = ROOT / "docs" / "TROUBLESHOOTING.md"
+README = ROOT / "README.md"
+AQUA = ROOT / "examples" / "aqua-matrixtv-ee-50" / "debloat.txt"
+TITLE = "- **The TV restarts in a loop after a debloat**"
+
+# The eight packages the reply on #1578 read off the attached disabled-package list.
+EIGHT = [
+    "com.cltv.mal",
+    "com.cltv.hybrid",
+    "com.mediatek.dtv.tvinput.isdbtuner",
+    "com.mediatek.dtv.tvinput.atsctuner",
+    "com.haier.gamingbar",
+    "ru.haier.evo",
+    "com.haier.apps.evoSmart",
+    "it.hon.onboarding",
+]
+
+
+def bullet(text, start):
+    """The markdown bullet that begins with `start`, up to the next top-level bullet, on one line."""
+    lines = text.split("\n")
+    first = next(i for i, line in enumerate(lines) if line.startswith(start))
+    out = [lines[first]]
+    for line in lines[first + 1:]:
+        if line.startswith("- **") or line.startswith("## "):
+            break
+        out.append(line)
+    return re.sub(r"\s+", " ", "\n".join(out))
+
+
+def factory_disabled(path):
+    """Package names the list header records after "Already disabled from the factory:"."""
+    header = " ".join(line.lstrip("#").strip() for line in path.read_text(encoding="utf-8").splitlines()
+                      if line.startswith("#"))
+    after = header.split("Already disabled from the factory:", 1)[1].split(". ", 1)[0]
+    return set(re.findall(r"[a-z][\w]*(?:\.[\w]+)+", after))
+
+
+class HaierLoopBulletTest(unittest.TestCase):
+    def setUp(self):
+        self.text = TROUBLE.read_text(encoding="utf-8")
+        self.loop = bullet(self.text, TITLE)
+
+    def test_bullet_sits_under_working_on_the_tv(self):
+        section = self.text.split("## Working on the TV", 1)[1].split("\n## ", 1)[0]
+        self.assertIn(TITLE, section)
+
+    def test_bullet_names_the_set_and_the_report(self):
+        for token in ("Haier H50H5F", "Google TV 14", "seen once", "issues/1578"):
+            with self.subTest(token=token):
+                self.assertIn(token, self.loop)
+
+    def test_bullet_does_not_say_the_agent_disabled_the_eight(self):
+        self.assertIn("What the agent disabled is not known", self.loop)
+        self.assertNotRegex(self.loop, r"(?i)the agent's list disabled")
+        self.assertNotRegex(self.loop, r"(?i)\bboth tuner inputs\b")
+        self.assertNotRegex(self.loop, r"(?i)likely cause")
+        self.assertNotIn("`com.cltv.mal`**", self.loop, "the bold symptom must not name a cause")
+
+    def test_bullet_says_the_list_may_be_the_backup(self):
+        self.assertIn("PROMPT.md", self.loop)
+        self.assertIn("before changing anything", self.loop)
+        self.assertIn("may be the TV's state before the debloat", self.loop)
+
+    def test_five_of_the_eight_are_factory_disabled_on_the_aqua(self):
+        # The count in the bullet must match the AQUA list it links.
+        on_aqua = factory_disabled(AQUA) & set(EIGHT)
+        self.assertEqual(len(on_aqua), 5, sorted(on_aqua))
+        self.assertIn("five of those eight are disabled from the factory", self.loop)
+        self.assertIn("(../examples/aqua-matrixtv-ee-50/debloat.txt)", self.loop)
+        self.assertTrue(AQUA.is_file())
+
+    def test_bullet_does_not_offer_the_eight_as_the_undo(self):
+        self.assertNotRegex(self.loop, r"(?i)lists all eight|re-enable all eight")
+        for package in EIGHT[2:]:
+            with self.subTest(package=package):
+                self.assertNotIn(f"pm enable {package}", self.loop)
+        self.assertIn("would switch on what the factory left off", self.loop)
+        self.assertIn("each package from the list that was applied", self.loop)
+
+    def test_bullet_keeps_the_way_back(self):
+        self.assertIn("adb mdns services", self.loop)
+        self.assertIn("recovery menu", self.loop)
+        self.assertIn("factory reset turns every disabled package back on", self.loop)
+        self.assertIn("nothing was uninstalled", self.loop)
+
+
+class ReadmeSafetyAnswerTest(unittest.TestCase):
+    def test_readme_points_to_the_factory_reset_and_the_bullet(self):
+        text = README.read_text(encoding="utf-8")
+        answer = text.split("<b>Is this safe? Can it brick the TV?</b>", 1)[1].split("</details>", 1)[0]
+        answer = re.sub(r"\s+", " ", answer)
+        for token in ("factory reset from its recovery menu", "issues/1578", "issues/1592",
+                      "docs/TROUBLESHOOTING.md#working-on-the-tv"):
+            with self.subTest(token=token):
+                self.assertIn(token, answer)
+
+
+if __name__ == "__main__":
+    unittest.main()
