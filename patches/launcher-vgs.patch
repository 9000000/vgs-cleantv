diff --git a/launcher/app/src/main/java/com/gathin/tvhome/QuietBehind.java b/launcher/app/src/main/java/com/gathin/tvhome/QuietBehind.java
new file mode 100644
index 00000000..26eaad84
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/QuietBehind.java
@@ -0,0 +1,41 @@
+package com.gathin.tvhome;
+
+import android.content.Context;
+import android.media.AudioFocusRequest;
+import android.media.AudioManager;
+import android.media.session.MediaController;
+
+/**
+ * CleanTV/VGS: hush the app left playing behind Home (feedback 01/11 and 03/11/2026: "bấm Home mở app khác, tiếng app
+ * cũ vẫn chạy ngầm", "tắt tivi mà TV360 vẫn phát"). The stock launchers take audio focus for their own trailers, so
+ * the players that only stop on focus loss went quiet there. Off with "pause_behind_home": false, for music kept on.
+ */
+final class QuietBehind {
+    static final String KEY = "pause_behind_home";
+
+    private QuietBehind() {
+    }
+
+    static void run(Context ctx) {
+        if (!Weather.flag(ctx, KEY, true)) return;
+        // Sessions first (when the now-playing listener is allowed): the player pauses as its own button would.
+        for (MediaController c : NowPlaying.active(ctx)) {
+            if (!NowPlaying.playing(c)) continue;
+            try {
+                c.getTransportControls().pause();
+            } catch (RuntimeException ignored) {
+            }
+        }
+        // Then a permanent focus gain, given straight back: every player that honours focus loss stops.
+        AudioManager audio = ctx.getSystemService(AudioManager.class);
+        if (audio == null) return;
+        AudioFocusRequest request = new AudioFocusRequest.Builder(AudioManager.AUDIOFOCUS_GAIN)
+                .setOnAudioFocusChangeListener(change -> { })
+                .build();
+        try {
+            if (audio.requestAudioFocus(request) == AudioManager.AUDIOFOCUS_REQUEST_GRANTED) audio.abandonAudioFocusRequest(request);
+        } catch (RuntimeException ignored) {
+        }
+    }
+}
+
