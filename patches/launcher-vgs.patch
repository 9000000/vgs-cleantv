+            eventsRow.setVisibility(View.GONE);
+            return;
+        } else {
+            eventsRow.setVisibility(View.VISIBLE);
+        }
+        LayoutInflater inflater = LayoutInflater.from(this);
+        for (EventsTracker.EventChip c : chips) {
+            View chipView = inflater.inflate(R.layout.item_event_chip, eventsRow, false);
+            ImageView icon = chipView.findViewById(R.id.chipIcon);
+            TextView title = chipView.findViewById(R.id.chipTitle);
+            TextView when = chipView.findViewById(R.id.chipWhen);
+            icon.setImageResource(c.iconRes);
+            title.setText(c.title);
+            when.setText(c.whenText);
+            try {
+                title.setTypeface(getResources().getFont(R.font.lexend_medium));
+                when.setTypeface(getResources().getFont(R.font.lexend));
+            } catch (Exception ignored) {}
+            if (c.isToday) {
+                chipView.setBackgroundResource(R.drawable.bg_event_chip_today);
+                when.setTextColor(0xFFFFD479);
+            } else {
+                chipView.setBackgroundResource(R.drawable.bg_event_chip);
+                when.setTextColor(0x8CFFFFFF);
+            }
+            eventsRow.addView(chipView);
+        }
+    }
