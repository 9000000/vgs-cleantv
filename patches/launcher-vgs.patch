-        text = "\n".join([
-            "```markdown",
-            "</details>",
-            "## Shown as an example",
-            "```",
-            "<!--",
-            "<details>",
-            "## Hidden on purpose",
-            "-->",
-            '<a id="anchor"></a>',
-            "## A heading after inline HTML",
