-#   size=$(stat -c %s launcher/app/build/outputs/apk/release/app-release.apk)
-#   test "$size" -lt 589824
-STAT_LINE = re.compile(r"size=\$\(stat -c %s ([^)\s]+)\)")
-LIMIT_LINE = re.compile(r'test "\$size" -lt (\d+)')
-JOB_HEAD = re.compile(r"^  ([a-z][a-z0-9-]*):\s*$", re.M)
