+package com.gathin.tvhome;
+
+import android.content.Context;
+
+import org.json.JSONObject;
+
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.InputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.util.Locale;
+
+/**
+ * CleanTV/VGS: one weather line under the greeting, e.g. "30°C Trời quang · Vinh".
+ * Off unless config.json has weather_lat and weather_lon (and optionally weather_place).
+ * Data from Open-Meteo (free, no key), read at most every 30 minutes while Home is on screen.
+ */
+final class Weather {
+    final double lat, lon;
+    final String place;
+
+    private Weather(double lat, double lon, String place) {
+        this.lat = lat;
+        this.lon = lon;
+        this.place = place;
+    }
+
+    /** The configured place, or null when the weather line is off. */
+    static Weather load(Context ctx) {
+        File dir = Config.dir(ctx);
+        File f = dir != null ? new File(dir, Config.FILE_NAME) : null;
+        if (f == null || !f.isFile() || f.length() > 64 * 1024) return null;
+        try (InputStream in = new FileInputStream(f)) {
+            JSONObject j = new JSONObject(new String(readAll(in), "UTF-8"));
+            if (!j.has("weather_lat") || !j.has("weather_lon")) return null;
+            double lat = j.getDouble("weather_lat"), lon = j.getDouble("weather_lon");
+            if (lat < -90 || lat > 90 || lon < -180 || lon > 180) return null;
+            return new Weather(lat, lon, j.optString("weather_place", "").trim());
+        } catch (Exception e) {
+            return null;
+        }
+    }
+
+    /**
+     * CleanTV/VGS: config.json locale ("vi", "en"…) overrides the TV's language for this launcher (25/10/2026: China Xiaomi
+     * firmware has no Vietnamese, so Home showed Chinese). Wraps an Activity's base context; missing or bad means no change.
+     */
+    static Context ngonNgu(Context base) {
+        File dir = Config.dir(base);
+        File f = dir != null ? new File(dir, Config.FILE_NAME) : null;
+        if (f == null || !f.isFile() || f.length() > 64 * 1024) return base;
+        try (InputStream in = new FileInputStream(f)) {
+            String tag = new JSONObject(new String(readAll(in), "UTF-8")).optString("locale", "").trim();
+            if (!tag.matches("[a-z]{2,3}(-[A-Za-z0-9]{2,8})?")) return base;
+            java.util.Locale l = java.util.Locale.forLanguageTag(tag);
+            java.util.Locale.setDefault(l);
+            android.content.res.Configuration c = new android.content.res.Configuration(base.getResources().getConfiguration());
+            c.setLocale(l);
+            return base.createConfigurationContext(c);
+        } catch (Exception e) {
+            return base;
+        }
+    }
+
+    /** CleanTV/VGS: a true/false key from config.json (e.g. dock_band), def when missing or unreadable. */
+    /** CleanTV/VGS: an int key from config.json, clamped to [min, max]; def when missing or not a number. */
+    static int so(Context ctx, String key, int def, int min, int max) {
+        File dir = Config.dir(ctx);
+        File f = dir != null ? new File(dir, Config.FILE_NAME) : null;
+        if (f == null || !f.isFile() || f.length() > 64 * 1024) return def;
+        try (InputStream in = new FileInputStream(f)) {
+            JSONObject j = new JSONObject(new String(readAll(in), "UTF-8"));
+            if (!j.has(key)) return def;
+            return Math.max(min, Math.min(max, j.optInt(key, def)));
+        } catch (Exception e) {
+            return def;
+        }
+    }
+
+    static boolean flag(Context ctx, String key, boolean def) {
+        File dir = Config.dir(ctx);
+        File f = dir != null ? new File(dir, Config.FILE_NAME) : null;
+        if (f == null || !f.isFile() || f.length() > 64 * 1024) return def;
+        try (InputStream in = new FileInputStream(f)) {
+            JSONObject j = new JSONObject(new String(readAll(in), "UTF-8"));
+            return j.has(key) ? j.optBoolean(key, def) : def;
+        } catch (Exception e) {
+            return def;
+        }
+    }
+
+    /**
+     * CleanTV/VGS: Ưu tiên config.json nếu người dùng đặt trong Cài đặt nâng cao / Theme,
+     * đồng thời đồng bộ vào choices để màn Cài đặt Launcher luôn hiển thị đúng trạng thái.
+     */
+    static boolean flagOrChoice(Context ctx, android.content.SharedPreferences choices, String key, boolean def) {
+        File dir = Config.dir(ctx);
+        File f = dir != null ? new File(dir, Config.FILE_NAME) : null;
+        if (f != null && f.isFile() && f.length() <= 64 * 1024) {
+            try (InputStream in = new FileInputStream(f)) {
+                JSONObject j = new JSONObject(new String(readAll(in), "UTF-8"));
+                if (j.has(key)) {
+                    boolean val = j.optBoolean(key, def);
+                    if (choices != null) {
+                        choices.edit().putBoolean(key, val).apply();
+                    }
+                    return val;
+                }
+            } catch (Exception ignored) {
+            }
+        }
+        return choices != null ? choices.getBoolean(key, def) : def;
+    }
+
+    /**
+     * CleanTV/VGS: projector shortcuts from config.json, "Label=package/activity" each (the activity may start with
+     * "." for one inside the package). Bad entries are skipped. Empty when the key is missing.
+     */
+    static java.util.List<String[]> projectorActions(Context ctx) {
+        java.util.List<String[]> out = new java.util.ArrayList<>();
+        File dir = Config.dir(ctx);
+        File f = dir != null ? new File(dir, Config.FILE_NAME) : null;
+        if (f == null || !f.isFile() || f.length() > 64 * 1024) return out;
+        try (InputStream in = new FileInputStream(f)) {
+            org.json.JSONArray a = new JSONObject(new String(readAll(in), "UTF-8")).optJSONArray("projector_actions");
+            if (a == null) return out;
+            for (int i = 0; i < a.length() && out.size() < 6; i++) {
+                String e = a.optString(i, "");
+                int eq = e.indexOf('=');
+                if (eq <= 0) continue;
+                String label = e.substring(0, eq).trim(), comp = e.substring(eq + 1).trim();
+                if (label.isEmpty() || android.content.ComponentName.unflattenFromString(comp) == null) continue;
+                out.add(new String[]{label, comp});
+            }
+        } catch (Exception ignored) {
+        }
+        return out;
+    }
+
+    public static class FullWeather {
+        public int temp = 28;
+        public boolean isDay = false;
+        public int code = 0;
+        public int iconRes = R.drawable.ic_weather_clear_night;
+        public String desc = "Trời quang";
+        public String meta = "Cao 33° · Thấp 25° · Ẩm 79%";
+        public int humidity = 79;
+        public int maxTemp = 33;
+        public int minTemp = 25;
+        public int aqi = 84;
+        public String aqiLabel = "Trung bình";
+        public int aqiColor = 0xFFF5D63D;
+        public String aqiAdvice = "Người nhạy cảm nên hạn chế ra ngoài lâu";
+        public java.util.List<DayForecast> days = new java.util.ArrayList<>();
+        public String place = "";
+
+        public static FullWeather getLatest() {
+            return cachedFull != null ? cachedFull : new FullWeather();
+        }
+
+        public String getShortLine() {
+            String iconStr = Weather.icon(code, isDay);
+            return iconStr + " " + temp + "° " + desc;
+        }
+
+        public String getAqiLine() {
+            return "● AQI " + aqi + " · " + aqiLabel;
+        }
+    }
+
+    public static class DayForecast {
+        public final String dayName;
+        public final int code;
+        public final int iconRes;
+        public final String icon;
+        public final int maxTemp;
+        public final int minTemp;
+
+        public DayForecast(String dayName, int code, String icon, int maxTemp, int minTemp) {
+            this.dayName = dayName;
+            this.code = code;
+            this.icon = icon;
+            this.maxTemp = maxTemp;
+            this.minTemp = minTemp;
+            this.iconRes = getIconRes(code, true);
+        }
+    }
+
+    public static int getIconRes(int code, boolean isDay) {
+        if ((code >= 51 && code <= 67) || (code >= 80 && code <= 82) || code >= 95) {
+            return R.drawable.ic_weather_rain;
+        }
+        if ((code >= 1 && code <= 3) || code == 45 || code == 48) {
+            return R.drawable.ic_weather_cloudy;
+        }
+        return isDay ? R.drawable.ic_weather_clear_day : R.drawable.ic_weather_clear_night;
+    }
+
+    public interface WeatherCallback {
+        void onLoaded(FullWeather fw);
+    }
+
+    public static void fetchFull(Context ctx, WeatherCallback callback) {
+        if (cachedFull != null && callback != null) {
+            callback.onLoaded(cachedFull);
+        }
+        new Thread(() -> {
+            FullWeather fw = getCachedOrFetch(ctx);
+            if (callback != null) {
+                callback.onLoaded(fw);
+            }
+        }, "weather-full").start();
+    }
+
+    /** Mặc định cache để hiển thị tức thì. */
+    private static volatile FullWeather cachedFull = null;
+
+    static FullWeather getCachedOrFetch(Context ctx) {
+        if (cachedFull != null) return cachedFull;
+        Weather w = load(ctx);
+        if (w == null) w = new Weather(21.03, 105.85, "Hà Nội");
+        cachedFull = w.fetchFull();
+        return cachedFull;
+    }
+
+    static void setCachedFull(FullWeather fw) {
+        cachedFull = fw;
+    }
+
+    FullWeather fetchFull() {
+        FullWeather fw = new FullWeather();
+        fw.place = this.place;
+        HttpURLConnection c = null;
+        try {
+            // 1. Dự báo thời tiết hiện tại và 5 ngày tới
+            URL url = new URL(String.format(Locale.US,
+                    "https://api.open-meteo.com/v1/forecast?latitude=%.4f&longitude=%.4f&timezone=auto&current=temperature_2m,relative_humidity_2m,weather_code,is_day&daily=weather_code,temperature_2m_max,temperature_2m_min&forecast_days=5",
+                    lat, lon));
+            c = (HttpURLConnection) url.openConnection();
+            c.setConnectTimeout(8000);
+            c.setReadTimeout(8000);
+            if (c.getResponseCode() == 200) {
+                JSONObject root = new JSONObject(new String(readAll(c.getInputStream()), "UTF-8"));
+                JSONObject cur = root.optJSONObject("current");
+                if (cur != null) {
+                    fw.temp = (int) Math.round(cur.optDouble("temperature_2m", 28.0));
+                    fw.humidity = cur.optInt("relative_humidity_2m", 79);
+                    fw.code = cur.optInt("weather_code", 0);
+                    fw.isDay = cur.optInt("is_day", 1) == 1;
+                    fw.desc = label(fw.code);
+                    fw.iconRes = getIconRes(fw.code, fw.isDay);
+                }
+                JSONObject daily = root.optJSONObject("daily");
+                if (daily != null) {
+                    org.json.JSONArray maxArr = daily.optJSONArray("temperature_2m_max");
+                    org.json.JSONArray minArr = daily.optJSONArray("temperature_2m_min");
+                    org.json.JSONArray codeArr = daily.optJSONArray("weather_code");
+                    if (maxArr != null && maxArr.length() > 0) fw.maxTemp = (int) Math.round(maxArr.optDouble(0, 33.0));
+                    if (minArr != null && minArr.length() > 0) fw.minTemp = (int) Math.round(minArr.optDouble(0, 25.0));
+                    fw.meta = "Cao " + fw.maxTemp + "° · Thấp " + fw.minTemp + "° · Ẩm " + fw.humidity + "%";
+
+                    String[] DOW_NAMES = {"CN", "Th 2", "Th 3", "Th 4", "Th 5", "Th 6", "Th 7"};
+                    java.util.Calendar cal = java.util.Calendar.getInstance();
+                    int todayDow = cal.get(java.util.Calendar.DAY_OF_WEEK) - 1;
+                    if (codeArr != null) {
+                        for (int i = 1; i < Math.min(5, codeArr.length()); i++) {
+                            int dCode = codeArr.optInt(i, 0);
+                            int dMax = maxArr != null ? (int) Math.round(maxArr.optDouble(i, 30.0)) : 30;
+                            int dMin = minArr != null ? (int) Math.round(minArr.optDouble(i, 24.0)) : 24;
+                            if (dMax < dMin) {
+                                int t = dMax;
+                                dMax = dMin;
+                                dMin = t;
+                            }
+                            int nextDowIdx = (todayDow + i) % 7;
+                            String dDow = DOW_NAMES[nextDowIdx];
+                            String dIcon = icon(dCode, true);
+                            fw.days.add(new DayForecast(dDow, dCode, dIcon, dMax, dMin));
+                        }
+                    }
+                }
+            }
+        } catch (Exception ignored) {
+        } finally {
+            if (c != null) c.disconnect();
+        }
+
+        // 2. Chỉ số chất lượng không khí (AQI)
+        HttpURLConnection cAir = null;
+        try {
+            URL urlAir = new URL(String.format(Locale.US,
+                    "https://air-quality-api.open-meteo.com/v1/air-quality?latitude=%.4f&longitude=%.4f&timezone=auto&current=us_aqi",
+                    lat, lon));
+            cAir = (HttpURLConnection) urlAir.openConnection();
+            cAir.setConnectTimeout(8000);
+            cAir.setReadTimeout(8000);
+            if (cAir.getResponseCode() == 200) {
+                JSONObject root = new JSONObject(new String(readAll(cAir.getInputStream()), "UTF-8"));
+                JSONObject cur = root.optJSONObject("current");
+                if (cur != null) {
+                    fw.aqi = cur.optInt("us_aqi", 84);
+                    setAqiBand(fw);
+                }
+            }
+        } catch (Exception ignored) {
+            setAqiBand(fw);
+        } finally {
+            if (cAir != null) cAir.disconnect();
+        }
+
+        if (fw.days.isEmpty()) {
+            String[] DOW_NAMES = {"CN", "Th 2", "Th 3", "Th 4", "Th 5", "Th 6", "Th 7"};
+            java.util.Calendar cal = java.util.Calendar.getInstance();
+            int todayDow = cal.get(java.util.Calendar.DAY_OF_WEEK) - 1;
+            fw.days.add(new DayForecast(DOW_NAMES[(todayDow + 1) % 7], 61, "🌧️", 32, 26));
+            fw.days.add(new DayForecast(DOW_NAMES[(todayDow + 2) % 7], 61, "🌧️", 31, 24));
+            fw.days.add(new DayForecast(DOW_NAMES[(todayDow + 3) % 7], 61, "🌧️", 31, 24));
+            fw.days.add(new DayForecast(DOW_NAMES[(todayDow + 4) % 7], 61, "🌧️", 31, 24));
+        }
+
+        cachedFull = fw;
+        return fw;
+    }
+
+    private static void setAqiBand(FullWeather fw) {
+        int aqi = fw.aqi;
+        if (aqi <= 50) {
+            fw.aqiLabel = "Tốt";
+            fw.aqiColor = 0xFF3DDC84;
+            fw.aqiAdvice = "Không khí trong lành";
+        } else if (aqi <= 100) {
+            fw.aqiLabel = "Trung bình";
+            fw.aqiColor = 0xFFF5D63D;
+            fw.aqiAdvice = "Người nhạy cảm nên hạn chế ra ngoài lâu";
+        } else if (aqi <= 150) {
+            fw.aqiLabel = "Kém";
+            fw.aqiColor = 0xFFFF9A3C;
+            fw.aqiAdvice = "Trẻ nhỏ, người già nên hạn chế ra ngoài";
+        } else if (aqi <= 200) {
+            fw.aqiLabel = "Xấu";
+            fw.aqiColor = 0xFFFF5A5A;
+            fw.aqiAdvice = "Đóng cửa sổ, bật máy lọc không khí";
+        } else if (aqi <= 300) {
+            fw.aqiLabel = "Rất xấu";
+            fw.aqiColor = 0xFFB36BFF;
+            fw.aqiAdvice = "Ở trong nhà, đeo khẩu trang khi ra ngoài";
+        } else {
+            fw.aqiLabel = "Nguy hại";
+            fw.aqiColor = 0xFFC2185B;
+            fw.aqiAdvice = "Tránh ra ngoài";
+        }
+    }
+
+    /** Fetches the current conditions; runs off the main thread. Null on any failure. */
+    String fetch() {
+        FullWeather fw = fetchFull();
+        if (fw == null) return null;
+        String text = fw.getShortLine();
+        return place.isEmpty() ? text : text + " · " + place;
+    }
+
+    /** WMO weather code → an emoji before the temperature (feedback 24/10/2026: "có thêm hình biểu tượng thời tiết"). */
+    static String icon(int code) {
+        return icon(code, true);
+    }
+
+    static String icon(int code, boolean isDay) {
+        if (!isDay && code <= 1) return "\uD83C\uDF19"; // 🌙 Moon for clear night
+        if (code == 0) return "\u2600\uFE0F";
+        if (code == 1 || code == 2) return "\u26C5";
+        if (code == 3) return "\u2601\uFE0F";
+        if (code == 45 || code == 48) return "\uD83C\uDF2B\uFE0F";
+        if (code >= 71 && code <= 77) return "\u2744\uFE0F";
+        if (code >= 95) return "\u26C8\uFE0F";
+        if (code >= 51) return "\uD83C\uDF27\uFE0F";
+        return "\uD83C\uDF21\uFE0F";
+    }
+
+    /** WMO weather code → a short label in Vietnamese or English, by the TV's language. */
+    static String label(int code) {
+        boolean vi = "vi".equals(Locale.getDefault().getLanguage());
+        if (code == 0) return vi ? "Trời quang" : "Clear";
+        if (code == 1) return vi ? "Ít mây" : "Mostly clear";
+        if (code == 2) return vi ? "Có mây" : "Partly cloudy";
+        if (code == 3) return vi ? "Nhiều mây" : "Overcast";
+        if (code == 45 || code == 48) return vi ? "Sương mù" : "Fog";
+        if (code >= 51 && code <= 57) return vi ? "Mưa phùn" : "Drizzle";
+        if (code == 65 || code == 67) return vi ? "Mưa to" : "Heavy rain";
+        if (code >= 61 && code <= 67) return vi ? "Mưa" : "Rain";
+        if (code >= 71 && code <= 77) return vi ? "Tuyết" : "Snow";
+        if (code >= 80 && code <= 82) return vi ? "Mưa rào" : "Showers";
+        if (code >= 95) return vi ? "Dông" : "Thunderstorm";
+        return "";
+    }
+
+    static byte[] readAll(InputStream in) throws java.io.IOException {
+        ByteArrayOutputStream out = new ByteArrayOutputStream();
+        byte[] buf = new byte[8192];
+        int n;
+        while ((n = in.read(buf)) > 0) out.write(buf, 0, n);
+        return out.toByteArray();
+    }
+}
