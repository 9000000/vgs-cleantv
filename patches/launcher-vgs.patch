--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/LinkTiles.java
@@ -0,0 +1,208 @@
+package com.gathin.tvhome;
+
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.ColorFilter;
+import android.graphics.LinearGradient;
+import android.graphics.Paint;
+import android.graphics.PixelFormat;
+import android.graphics.Rect;
+import android.graphics.Shader;
+import android.graphics.Typeface;
+import android.graphics.drawable.Drawable;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.InputStream;
+import java.util.ArrayList;
+import java.util.List;
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+/**
+ * CleanTV/VGS: tiles that open a link in another app instead of the app's start screen, e.g. a TV channel straight
+ * in VTVgo (feedback 23/10/2026: "lôi các kênh VTV1, VTV2, VTV3 ra màn chính" for parents). config.json
+ * link_tiles holds "Label|package|uri|#colour" entries. Each tile behaves as an app whose package is
+ * {@link #PREFIX} plus the label in lower case, so dock_apps, the saved order and Remove from Home all work on it. A
+ * kenh-<that suffix>.jpg beside config.json (the channel's logo card) replaces the drawn label.
+ */
+final class LinkTiles {
+    static final String PREFIX = "vgs.kenh.";
+    private static final int MAX = 16;
+
+    static final class Link {
+        final String label, target, uri, pkg;
+        final int color;
+        /** The tile's picture (kenh-<label>.jpg beside config.json, sent by CleanTV), or null to draw the label. */
+        Drawable picture;
+
+        Link(String label, String target, String uri, int color) {
+            this.label = label;
+            this.target = target;
+            this.uri = uri;
+            this.color = color;
+            this.pkg = PREFIX + label.toLowerCase(java.util.Locale.ROOT).replaceAll("[^a-z0-9]", "");
+        }
+    }
+
+    private LinkTiles() {
+    }
+
+    /** The link_tiles entry behind a tile package ({@link #PREFIX}…), or null when it is gone. */
+    static Link find(Context ctx, String pkg) {
+        for (Link l : load(ctx)) if (l.pkg.equals(pkg)) return l;
+        return null;
+    }
+
+    /** CleanTV/VGS: how long TV360 gets to bring its home up before the channel link (slow TVs: 3 s). */
+    private static final long TV360_CHANNEL_DELAY_MS = 3000;
+    /**
+     * Right after a boot TV360's splash takes far longer (about 10 s on the emulator, 02/11/2026) and its home, when it
+     * comes, covers a channel sent earlier: wait 15 s during the first 3 minutes after boot.
+     */
+    private static final long TV360_BOOT_DELAY_MS = 15_000, BOOT_WINDOW_MS = 180_000;
+
+    /**
+     * Opens a link in its app; if the app no longer takes the link, opens the app itself. False when nothing opened.
+     * Used by the tile and by Open on start (a channel picked as the app to open at power-on, LinkOpenActivity).
+     */
+    static boolean open(Context ctx, String uri, String target) {
+        android.content.Intent view = new android.content.Intent(android.content.Intent.ACTION_VIEW, android.net.Uri.parse(uri)).setPackage(target)
+                .addFlags(android.content.Intent.FLAG_ACTIVITY_NEW_TASK);
+        // TV360 (6.4, 28/10/2026): a login screen left open on top swallowed the next channel tile; clear above its Home.
+        if (uri.startsWith("tv360:")) view.addFlags(android.content.Intent.FLAG_ACTIVITY_CLEAR_TOP);
+        android.content.pm.PackageManager pm = ctx.getPackageManager();
+        android.content.Intent open = pm.resolveActivity(view, 0) != null ? view : null;
+        // CleanTV/VGS: an IPTV stream (http/rtsp…) in a video player (VLC, MX Player…), whose filters ask for a video type.
+        if (open == null && !uri.startsWith("https://fptplay.vn")) {
+            android.content.Intent typed = new android.content.Intent(android.content.Intent.ACTION_VIEW).setDataAndType(android.net.Uri.parse(uri), "video/*").setPackage(target);
+            if (pm.resolveActivity(typed, 0) != null) open = typed;
+        }
+        if (open == null) open = pm.getLeanbackLaunchIntentForPackage(target);
+        if (open == null) open = pm.getLaunchIntentForPackage(target);
+        if (open == null) return false;
+        try {
+            // TV360: the tv360:// link opens HomeActivity directly, skipping SplashActivity's start-up, so Back from the
+            // channel left a TV360 home where nothing could be picked (lamtienmanh, Sony 43W800C + Mibox4, 02/11/2026).
+            // Open TV360 the normal way first, then hand it the channel once its home is up (about 1 s on the emulator).
+            android.content.Intent app = open == view ? pm.getLeanbackLaunchIntentForPackage(target) : null;
+            if (app != null && uri.startsWith("tv360:")) {
+                ctx.startActivity(app.addFlags(android.content.Intent.FLAG_ACTIVITY_NEW_TASK));
+                Context appCtx = ctx.getApplicationContext();
+                new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(() -> {
+                    try {
+                        appCtx.startActivity(view);
+                    } catch (Exception ignored) {
+                    }
+                }, android.os.SystemClock.elapsedRealtime() < BOOT_WINDOW_MS ? TV360_BOOT_DELAY_MS : TV360_CHANNEL_DELAY_MS);
+                return true;
+            }
+            ctx.startActivity(open.addFlags(android.content.Intent.FLAG_ACTIVITY_NEW_TASK));
+            return true;
+        } catch (Exception ex) {
+            return false;
+        }
+    }
+
+    /** The link_tiles entries whose target app is installed; bad entries are skipped. */
+    static List<Link> load(Context ctx) {
+        List<Link> out = new ArrayList<>();
+        File dir = Config.dir(ctx);
+        JSONObject cauHinh = Weather.cauHinh(ctx);
+        if (cauHinh == null) return out;
+        try {
+            JSONArray a = cauHinh.optJSONArray("link_tiles");
+            if (a == null) return out;
+            for (int i = 0; i < a.length() && out.size() < MAX; i++) {
+                String[] p = a.optString(i, "").split("\\|", -1);
+                if (p.length < 3) continue;
+                String label = p[0].trim(), target = p[1].trim(), uri = p[2].trim();
+                if (label.isEmpty() || label.length() > 24 || target.isEmpty() || !uri.contains(":")) continue;
+                int color = 0xFF3A3A44;
+                if (p.length > 3) {
+                    try {
+                        color = Color.parseColor(p[3].trim());
+                    } catch (IllegalArgumentException ignored) {
+                    }
+                }
+                try {
+                    ctx.getPackageManager().getPackageInfo(target, 0);
+                } catch (Exception notInstalled) {
+                    continue;
+                }
+                Link l = new Link(label, target, uri, color | 0xFF000000);
+                File pic = dir == null ? null : new File(dir, "kenh-" + l.pkg.substring(PREFIX.length()) + ".jpg");
+                if (pic != null && pic.isFile() && pic.length() < 512 * 1024) {
+                    android.graphics.Bitmap b = android.graphics.BitmapFactory.decodeFile(pic.getPath());
+                    if (b != null) l.picture = new android.graphics.drawable.BitmapDrawable(ctx.getResources(), b);
+                }
+                out.add(l);
+            }
+        } catch (Exception ignored) {
+        }
+        return out;
+    }
+
+    /** The tile face: the label in large bold type on a gradient of the link's colour, filling the whole card. */
+    static final class Face extends Drawable {
+        private final String text;
+        private final int color;
+        private final Paint fill = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final Paint type = new Paint(Paint.ANTI_ALIAS_FLAG);
+
+        Face(String text, int color) {
+            this.text = text;
+            this.color = color;
+            type.setColor(Color.WHITE);
+            type.setTypeface(Typeface.create(Typeface.DEFAULT, Typeface.BOLD));
+            type.setTextAlign(Paint.Align.CENTER);
+        }
+
+        @Override
+        protected void onBoundsChange(Rect b) {
+            float[] hsv = new float[3];
+            Color.colorToHSV(color, hsv);
+            hsv[2] *= 0.62f;
+            fill.setShader(new LinearGradient(0, b.top, 0, b.bottom, color, Color.HSVToColor(hsv), Shader.TileMode.CLAMP));
+            float size = b.height() * 0.38f;
+            type.setTextSize(size);
+            // Long labels shrink to fit the card's width with a margin either side.
+            float w = type.measureText(text);
+            if (w > b.width() * 0.84f) type.setTextSize(size * b.width() * 0.84f / w);
+        }
+
+        @Override
+        public void draw(Canvas c) {
+            Rect b = getBounds();
+            c.drawRect(b, fill);
+            Paint.FontMetrics m = type.getFontMetrics();
+            c.drawText(text, b.exactCenterX(), b.exactCenterY() - (m.ascent + m.descent) / 2f, type);
+        }
+
+        @Override
+        public void setAlpha(int alpha) {
+            fill.setAlpha(alpha);
+            type.setAlpha(alpha);
+        }
+
+        @Override
+        public void setColorFilter(ColorFilter cf) {
+            fill.setColorFilter(cf);
+        }
+
+        @Override
+        public int getOpacity() {
+            return PixelFormat.OPAQUE;
+        }
+
+        @Override
+        public int getIntrinsicWidth() {
+            return 320;
+        }
+
+        @Override
+        public int getIntrinsicHeight() {
+            return 180;
+        }
+    }
+}
