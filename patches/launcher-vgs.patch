diff --git a/launcher/app/src/main/java/com/gathin/tvhome/SleepTimer.java b/launcher/app/src/main/java/com/gathin/tvhome/SleepTimer.java
new file mode 100644
index 00000000..893ad6c3
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/SleepTimer.java
@@ -0,0 +1,66 @@
+package com.gathin.tvhome;
+
+import android.app.AlarmManager;
+import android.app.PendingIntent;
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.SharedPreferences;
+import android.widget.Toast;
+
+/**
+ * CleanTV/VGS: sleep_timer_button — a top-bar button that steps a sleep timer through off, 15, 30, 60 and 90 minutes
+ * (feedback 26/10/2026, Xiaomi A Pro 2026: the stock home's quick bar had one, and it went with the stock home). At the
+ * time an alarm reaches {@link Receiver}, which asks the key helper for GLOBAL_ACTION_LOCK_SCREEN, the TV's standby.
+ */
+final class SleepTimer {
+    static final int[] STEPS = {0, 15, 30, 60, 90};
+    private static final String PREFS = "vgs_sleep_timer", KEY = "until";
+
+    private SleepTimer() {
+    }
+
+    /** Minutes still to go, rounded up; 0 when no timer is set or it has passed. */
+    static int minutesLeft(long until, long now) {
+        return until <= now ? 0 : (int) ((until - now + 59_999L) / 60_000L);
+    }
+
+    /** The next step after the running one (the shortest step that still covers the minutes left), or off after the last. */
+    static int nextStep(int left) {
+        int i = 0;
+        while (i < STEPS.length - 1 && STEPS[i] < left) i++;
+        return i + 1 < STEPS.length ? STEPS[i + 1] : 0;
+    }
+
+    /** Press of the button: moves to the next step, sets or clears the alarm and says so. */
+    static void next(Context ctx) {
+        SharedPreferences prefs = ctx.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+        long now = System.currentTimeMillis();
+        int step = nextStep(minutesLeft(prefs.getLong(KEY, 0), now));
+        AlarmManager alarms = ctx.getSystemService(AlarmManager.class);
+        PendingIntent pi = PendingIntent.getBroadcast(ctx, 0, new Intent(ctx, Receiver.class),
+                PendingIntent.FLAG_IMMUTABLE | PendingIntent.FLAG_UPDATE_CURRENT);
+        alarms.cancel(pi);
+        if (step == 0) {
+            prefs.edit().remove(KEY).apply();
+            Toast.makeText(ctx, R.string.sleep_timer_off, Toast.LENGTH_SHORT).show();
+            return;
+        }
+        long until = now + step * 60_000L;
+        prefs.edit().putLong(KEY, until).apply();
+        // On time when CleanTV granted SCHEDULE_EXACT_ALARM over ADB; otherwise Android may run it up to ~10 minutes late.
+        if (android.os.Build.VERSION.SDK_INT < 31 || alarms.canScheduleExactAlarms()) alarms.setExactAndAllowWhileIdle(AlarmManager.RTC_WAKEUP, until, pi);
+        else alarms.setAndAllowWhileIdle(AlarmManager.RTC_WAKEUP, until, pi);
+        Toast.makeText(ctx, ctx.getString(HomeKeyService.canSleep() ? R.string.sleep_timer_set : R.string.sleep_timer_no_helper, step),
+                Toast.LENGTH_LONG).show();
+    }
+
+    /** The alarm: standby through the key helper. */
+    public static final class Receiver extends BroadcastReceiver {
+        @Override
+        public void onReceive(Context context, Intent intent) {
+            context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit().remove(KEY).apply();
+            HomeKeyService.sleepNow();
+        }
+    }
+}
