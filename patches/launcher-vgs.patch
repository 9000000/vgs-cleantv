+    /** Re-reads the weather when the last reading is older than WEATHER_MS; called on resume and every minute. */
+    private void updateWeather() {
+        if (weatherCfg == null || weatherView.getVisibility() != View.VISIBLE) return;
+        long now = System.currentTimeMillis();
+        if (weatherThread != null || now - weatherAt < WEATHER_MS) return;
+        Weather w = weatherCfg;
+        weatherThread = new Thread(() -> {
+            String text = w.fetch();
+            handler.post(() -> {
+                weatherThread = null;
+                if (text != null) {
+                    weatherAt = System.currentTimeMillis();
+                    weatherView.setText(text);
+                } else {
+                    weatherAt = System.currentTimeMillis() - WEATHER_MS + 5 * 60 * 1000L;  // retry in 5 minutes
+                    if (weatherView.getText().length() == 0 && !w.place.isEmpty()) weatherView.setText(w.place);
+                }
+            });
+        }, "weather");
+        weatherThread.start();
+    }
