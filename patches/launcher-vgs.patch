+    // Bộ lọc an toàn gia đình: loại bỏ sự kiện thảm sát, đánh bom, tai nạn, khủng bố, gián điệp, tự sát, thảm họa...
+    private static final Pattern GRIM = Pattern.compile(
+            "\\b(kill|dead|death|bomb|attack|massacre|crash|shoot|shot\\b|murder|terror|genocide|hostage)\\b|" +
+            "giết|thảm sát|khủng bố|đánh bom|tử vong|thiệt mạng|xả súng|tai nạn|hành quyết|ám sát|con tin|" +
+            "sát hại|không tặc|phát nổ|\\bnổ\\b|tự sát|thảm khốc|chìm tàu|đắm tàu|động đất|sóng thần|giẫm đạp",
+            Pattern.CASE_INSENSITIVE | Pattern.UNICODE_CASE
+    );
+
+    private static final Pattern YEAR_PATTERN = Pattern.compile(
+            "^\\s*(?:\\[\\[(?:[^\\]|]*\\|)?(\\d{1,4})(?:\\s*TCN|\\s*BC)?\\]\\]|(?:\\[\\[)?(\\d{1,4})(?:\\s*TCN|\\s*BC)?(?:\\]\\])?)\\s*(?:&nbsp;)?\\s*[–—\\-:]?\\s*(.*)",
+            Pattern.CASE_INSENSITIVE
+    );
+
+    private static final List<HistoryItem> CACHED_ITEMS = Collections.synchronizedList(new ArrayList<>());
+    private static int cachedDay = -1;
+    private static int cachedMonth = -1;
+    private static volatile boolean isLoading = false;
+
+    /**
+     * Tương thích ngược: tải không cần truyền Context.
+     */
+    public static void loadToday(Callback callback) {
+        loadToday(null, callback);
+    }
+
+    /**
+     * Tải sự kiện của ngày hôm nay (chạy ngầm, gọi callback trên main thread).
+     * Có hỗ trợ bộ nhớ đệm đĩa SharedPreferences để offline-first ngay khi mở TV.
+     */
+    public static void loadToday(Context context, Callback callback) {
+        Calendar cal = Calendar.getInstance(TimeZone.getTimeZone("Asia/Ho_Chi_Minh"));
+        int day = cal.get(Calendar.DAY_OF_MONTH);
+        int month = cal.get(Calendar.MONTH) + 1;
+
+        if (day == cachedDay && month == cachedMonth && !CACHED_ITEMS.isEmpty()) {
+            if (callback != null) callback.onLoaded(new ArrayList<>(CACHED_ITEMS));
+            return;
+        }
+
+        // 1. Thử nạp nhanh từ bộ nhớ đệm đĩa SharedPreferences (đặc biệt hữu ích khi vừa boot TV chưa kịp có WiFi)
+        if (context != null && CACHED_ITEMS.isEmpty()) {
+            List<HistoryItem> diskItems = loadFromDiskCache(context, day, month);
+            if (!diskItems.isEmpty()) {
+                CACHED_ITEMS.clear();
+                CACHED_ITEMS.addAll(diskItems);
+                cachedDay = day;
+                cachedMonth = month;
+                if (callback != null) {
+                    callback.onLoaded(new ArrayList<>(CACHED_ITEMS));
+                }
+            }
+        }
+
+        if (isLoading) {
+            if (callback != null && !CACHED_ITEMS.isEmpty()) {
+                callback.onLoaded(new ArrayList<>(CACHED_ITEMS));
+            }
+            return;
+        }
+
+        isLoading = true;
+        new Thread(() -> {
+            List<HistoryItem> items = fetchFromWikipedia(day, month);
+            boolean success = !items.isEmpty();
+            if (success) {
+                CACHED_ITEMS.clear();
+                CACHED_ITEMS.addAll(items);
+                cachedDay = day;
+                cachedMonth = month;
+                if (context != null) {
+                    saveToDiskCache(context, day, month, items);
+                }
+            } else if (CACHED_ITEMS.isEmpty()) {
+                // Nếu chưa có cache và fetch mạng thất bại: nạp tập sự kiện dự phòng phong phú
+                items = getFallbackEvents(day, month);
+                CACHED_ITEMS.clear();
+                CACHED_ITEMS.addAll(items);
+                cachedDay = day;
+                cachedMonth = month;
+            }
+            isLoading = false;
+
+            final List<HistoryItem> result = new ArrayList<>(CACHED_ITEMS);
+            new Handler(Looper.getMainLooper()).post(() -> {
+                if (callback != null) callback.onLoaded(result);
+            });
+        }).start();
+    }
+
+    private static void saveToDiskCache(Context context, int day, int month, List<HistoryItem> items) {
+        try {
+            SharedPreferences sp = context.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE);
+            JSONArray arr = new JSONArray();
+            for (HistoryItem item : items) {
+                JSONObject obj = new JSONObject();
+                obj.put("year", item.year);
+                obj.put("text", item.text);
+                arr.put(obj);
+            }
+            sp.edit().putString(KEY_PREFIX + day + "_" + month, arr.toString()).apply();
+        } catch (Exception ignored) {}
+    }
+
+    private static List<HistoryItem> loadFromDiskCache(Context context, int day, int month) {
+        List<HistoryItem> list = new ArrayList<>();
+        try {
+            SharedPreferences sp = context.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE);
+            String raw = sp.getString(KEY_PREFIX + day + "_" + month, null);
+            if (raw != null && !raw.isEmpty()) {
+                JSONArray arr = new JSONArray(raw);
+                for (int i = 0; i < arr.length(); i++) {
+                    JSONObject obj = arr.getJSONObject(i);
+                    int year = obj.optInt("year", 0);
+                    String text = obj.optString("text", "");
+                    if (!text.isEmpty()) {
+                        list.add(new HistoryItem(year, text));
+                    }
+                }
+            }
+        } catch (Exception ignored) {}
+        return list;
+    }
+
+    private static List<HistoryItem> fetchFromWikipedia(int day, int month) {
+        HttpURLConnection conn = null;
+        try {
+            URL url = new URL("https://vi.wikipedia.org/w/api.php?action=parse&page=" + day + "_th%C3%A1ng_" + month + "&prop=wikitext&format=json");
+            conn = (HttpURLConnection) url.openConnection();
+            conn.setRequestMethod("GET");
+            conn.setRequestProperty("User-Agent", "CleanTV-AndroidTV/2.10 (https://vgs.zone/cleantv)");
+            conn.setRequestProperty("Accept", "application/json");
+            conn.setConnectTimeout(8000);
+            conn.setReadTimeout(8000);
+
+            if (conn.getResponseCode() == 200) {
+                BufferedReader br = new BufferedReader(new InputStreamReader(conn.getInputStream(), "UTF-8"));
+                StringBuilder sb = new StringBuilder();
+                String line;
+                while ((line = br.readLine()) != null) sb.append(line);
+                br.close();
+
+                JSONObject root = new JSONObject(sb.toString());
+                JSONObject parseObj = root.optJSONObject("parse");
+                if (parseObj != null) {
+                    JSONObject wtObj = parseObj.optJSONObject("wikitext");
+                    if (wtObj != null) {
+                        String wikitext = wtObj.optString("*", "");
+                        return parseWikiText(wikitext);
+                    }
+                }
+            }
+        } catch (Exception ignored) {
+        } finally {
+            if (conn != null) conn.disconnect();
+        }
+        return Collections.emptyList();
+    }
+
+    /**
+     * Bóc tách các sự kiện từ mã wikitext của Wikipedia tiếng Việt.
+     */
+    static List<HistoryItem> parseWikiText(String wikitext) {
+        List<HistoryItem> list = new ArrayList<>();
+        if (wikitext == null || wikitext.isEmpty()) return list;
+
+        int start = wikitext.indexOf("== Sự kiện ==");
+        if (start == -1) start = wikitext.indexOf("==Sự kiện==");
+        if (start != -1) {
+            int end = wikitext.indexOf("\n==", start + 12);
+            String section = (end != -1) ? wikitext.substring(start, end) : wikitext.substring(start);
+            String[] lines = section.split("\n");
+            int currentYear = 0;
+            for (String raw : lines) {
+                String l = raw.trim();
+                if (!l.startsWith("*")) continue;
+                boolean isSubBullet = l.startsWith("**");
+                l = l.replaceFirst("^\\*+", "").trim();
+                l = l.replace("&nbsp;", " ").replace("&#160;", " ");
+
+                Matcher m = YEAR_PATTERN.matcher(l);
+                if (m.matches() && !isSubBullet) {
+                    String yStr = m.group(1) != null ? m.group(1) : m.group(2);
+                    if (yStr != null) {
+                        try {
+                            int year = Integer.parseInt(yStr);
+                            currentYear = year;
+                            String text = cleanWikiText(m.group(3));
+                            if (!text.isEmpty() && !GRIM.matcher(text).find()) {
+                                list.add(new HistoryItem(year, text));
+                            }
+                        } catch (NumberFormatException ignored) {}
+                    }
+                } else if (isSubBullet && currentYear > 0) {
+                    String text = cleanWikiText(l);
+                    if (!text.isEmpty() && !GRIM.matcher(text).find()) {
+                        list.add(new HistoryItem(currentYear, text));
+                    }
+                }
+            }
+        }
+        return list;
+    }
+
+    static String cleanWikiText(String s) {
+        if (s == null) return "";
+        // 1. Unescape common HTML entities
+        s = s.replace("&nbsp;", " ").replace("&#160;", " ");
+        s = s.replace("&quot;", "\"").replace("&amp;", "&");
+        s = s.replace("&ndash;", "–").replace("&mdash;", "—");
+        s = s.replace("&lt;", "<").replace("&gt;", ">");
+
+        // 2. Remove references and comments
+        s = s.replaceAll("(?s)<ref[^>]*>.*?</ref>", "");
+        s = s.replaceAll("<ref[^>]*/>", "");
+        s = s.replaceAll("(?s)<!--.*?-->", "");
+        s = s.replaceAll("<[^>]*>", "");
+
+        // 3. Remove templates {{...}}
+        s = s.replaceAll("\\{\\{[^}]*\\}\\}", "");
+
+        // 4. Remove file/image links: [[Tập tin:...]] or [[File:...]]
+        s = s.replaceAll("(?i)\\[\\[(?:Tập tin|File|Image):[^\\]]*\\]\\]", "");
+
+        // 5. Convert wiki links: [[Target|Text]] -> Text, [[Target]] -> Target
+        s = s.replaceAll("\\[\\[(?:[^|\\]]*\\|)?([^\\]]+)\\]\\]", "$1");
+
+        // 6. Remove bold/italic quotes (''' and '')
+        s = s.replace("'''", "").replace("''", "");
+        s = s.replace("[[", "").replace("]]", "");
+
+        // 7. Strip leading/trailing separators and punctuation
+        s = s.replaceAll("^[\\s*–—\\-:]+", "");
+        s = s.replaceAll("^&[a-zA-Z0-9#]+;\\s*", "");
+        s = s.replaceAll("^[\\s*–—\\-:]+", "");
+
+        return s.replaceAll("\\s+", " ").trim();
+    }
+
