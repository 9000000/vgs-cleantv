+package com.gathin.tvhome;
+
+import java.util.Calendar;
+import java.util.Locale;
+
+/**
+ * CleanTV/VGS: Sự kiện và Đếm ngược ngày (Countdown) cho màn hình chính và màn hình chờ.
+ * - Tết Nguyên Đán, Giao thừa, Mùng 1, Rằm tháng Giêng, Rằm hàng tháng, Mùng 1 hàng tháng.
+ * - Các ngày lễ âm lịch và dương lịch Việt Nam (Giỗ Tổ Hùng Vương 10/3 AL, 30/4, 1/5, 2/9, Trung thu...).
+ * Thuật toán thiên văn âm lịch thuần Việt (Hồ Ngọc Đức, UTC+7), không phụ thuộc API ngoài.
+ */
+public final class EventsTracker {
+
+    private EventsTracker() {
+    }
+
+    private static final String[] LUNAR_MONTH_NAMES = {
+            "Giêng", "Hai", "Ba", "Tư", "Năm", "Sáu",
+            "Bảy", "Tám", "Chín", "Mười", "Mười Một", "Chạp"
+    };
+
+    public static class EventChip {
+        public final String title;
+        public final int days;
+        public final boolean isToday;
+        public final int iconRes;
+        public final String whenText;
+
+        public EventChip(String title, int days, int iconRes) {
+            this.title = title;
+            this.days = days;
+            this.isToday = (days == 0);
+            this.iconRes = iconRes;
+            if (days == 0) {
+                this.whenText = "Hôm nay";
+            } else if (days == 1) {
+                this.whenText = "ngày mai";
+            } else {
+                this.whenText = "còn " + days + " ngày";
+            }
+        }
+    }
+
+    public static class EventInfo {
+        public final String title;
+        public final int daysRemaining;
+        public final boolean isToday;
+        public final boolean isTomorrow;
+        public final String formatted;
+
+        public EventInfo(String title, int daysRemaining) {
+            this.title = title;
+            this.daysRemaining = daysRemaining;
+            this.isToday = (daysRemaining == 0);
+            this.isTomorrow = (daysRemaining == 1);
+            if (isToday) {
+                this.formatted = "Hôm nay là " + title;
+            } else if (isTomorrow) {
+                this.formatted = "Ngày mai là " + title;
+            } else {
+                this.formatted = "Còn " + daysRemaining + " ngày đến " + title;
+            }
+        }
+    }
+
+    /**
+     * Lấy danh sách 3 chip sự kiện sắp tới theo chuẩn Samsung Frame / Apple TV:
+     * 1) Rằm hoặc Mùng 1 gần nhất (hoặc hôm nay)
+     * 2) Ngày lễ hoặc sự kiện đặc biệt tiếp theo
+     * 3) Tết Nguyên Đán (hoặc ngày lễ kế tiếp)
+     */
+    public static java.util.List<EventChip> getUpcomingChips() {
+        java.util.List<EventChip> list = new java.util.ArrayList<>();
+        Calendar cal = Calendar.getInstance();
+        int curYear = cal.get(Calendar.YEAR);
+        int curMonth = cal.get(Calendar.MONTH) + 1;
+        int curDay = cal.get(Calendar.DAY_OF_MONTH);
+
+        // 1. Tìm Rằm hoặc Mùng 1 gần nhất (trong vòng 7 ngày)
+        EventChip moonChip = null;
+        for (int offset = 0; offset <= 7; offset++) {
+            Calendar target = Calendar.getInstance();
+            target.add(Calendar.DAY_OF_YEAR, offset);
+            int td = target.get(Calendar.DAY_OF_MONTH);
+            int tm = target.get(Calendar.MONTH) + 1;
+            int ty = target.get(Calendar.YEAR);
+
+            int[] lunar = Lunar.fromSolar(td, tm, ty, 7.0);
+            if (lunar[0] == 15) {
+                String mName = (lunar[1] >= 1 && lunar[1] <= 12) ? LUNAR_MONTH_NAMES[lunar[1] - 1] : String.valueOf(lunar[1]);
+                moonChip = new EventChip("Rằm tháng " + mName, offset, R.drawable.ic_event_moon);
+                break;
+            } else if (lunar[0] == 1) {
+                String mName = (lunar[1] >= 1 && lunar[1] <= 12) ? LUNAR_MONTH_NAMES[lunar[1] - 1] : String.valueOf(lunar[1]);
+                moonChip = new EventChip("Mùng 1 tháng " + mName, offset, R.drawable.ic_event_moon);
+                break;
+            }
+        }
+        if (moonChip != null) list.add(moonChip);
+
+        // 2. Tìm Tết Nguyên Đán (trong vòng 7 ngày)
+        EventChip tetChip = null;
+        for (int offset = 0; offset <= 7; offset++) {
+            Calendar target = Calendar.getInstance();
+            target.add(Calendar.DAY_OF_YEAR, offset);
+            int td = target.get(Calendar.DAY_OF_MONTH);
+            int tm = target.get(Calendar.MONTH) + 1;
+            int ty = target.get(Calendar.YEAR);
+
+            int[] lunar = Lunar.fromSolar(td, tm, ty, 7.0);
+            if (lunar[0] == 1 && lunar[1] == 1) {
+                tetChip = new EventChip("Tết Nguyên Đán", offset, R.drawable.ic_event_lantern);
+                break;
+            }
+        }
+
+        // 3. Tìm các ngày lễ nổi bật sắp tới (trong vòng 7 ngày)
+        EventChip holidayChip1 = null;
+        EventChip holidayChip2 = null;
+
+        for (int offset = 0; offset <= 7; offset++) {
+            Calendar target = Calendar.getInstance();
+            target.add(Calendar.DAY_OF_YEAR, offset);
+            int td = target.get(Calendar.DAY_OF_MONTH);
+            int tm = target.get(Calendar.MONTH) + 1;
+            int ty = target.get(Calendar.YEAR);
+
+            // Kiểm tra dương lịch
+            String solarName = getSolarHoliday(td, tm);
+            if (solarName != null) {
+                if (holidayChip1 == null) {
+                    holidayChip1 = new EventChip(solarName, offset, R.drawable.ic_event_star);
+                } else if (holidayChip2 == null && !solarName.equals(holidayChip1.title)) {
+                    holidayChip2 = new EventChip(solarName, offset, R.drawable.ic_event_star);
+                    break;
+                }
+            }
+
+            // Kiểm tra âm lịch
+            int[] lunar = Lunar.fromSolar(td, tm, ty, 7.0);
+            String lunarName = getLunarHoliday(lunar[0], lunar[1]);
+            if (lunarName != null && !lunarName.contains("Tết Nguyên Đán")) {
+                if (holidayChip1 == null) {
+                    holidayChip1 = new EventChip(lunarName, offset, R.drawable.ic_event_lantern);
+                } else if (holidayChip2 == null && !lunarName.equals(holidayChip1.title)) {
+                    holidayChip2 = new EventChip(lunarName, offset, R.drawable.ic_event_lantern);
+                    break;
+                }
+            }
+        }
+
+        if (holidayChip1 != null) list.add(holidayChip1);
+        if (tetChip != null && !list.contains(tetChip)) {
+            list.add(tetChip);
+        } else if (holidayChip2 != null) {
+            list.add(holidayChip2);
+        }
+
+        // Lọc nghiêm ngặt: chỉ giữ các sự kiện còn từ 0 đến 7 ngày nữa
+        list.removeIf(c -> c.days < 0 || c.days > 7);
+
+        // Sắp xếp theo thứ tự số ngày tăng dần
+        java.util.Collections.sort(list, (a, b) -> Integer.compare(a.days, b.days));
+        return list;
+    }
+
+    /**
+     * Dòng sự kiện cho screensaver (màn hình chờ), phân tách bằng dấu gạch đứng (|).
+     */
+    public static String getScreensaverEventsHtml() {
+        java.util.List<EventChip> chips = getUpcomingChips();
+        if (chips.isEmpty()) return "";
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < chips.size(); i++) {
+            if (i > 0) {
+                sb.append(" &nbsp;<font color='#80FFFFFF'>|</font>&nbsp; ");
+            }
+            EventChip c = chips.get(i);
+            if (c.isToday) {
+                sb.append("<font color='#FFD479'><b>").append(c.title).append("</b> hôm nay</font>");
+            } else {
+                sb.append("<b>").append(c.title).append("</b> ").append(c.whenText);
+            }
+        }
+        return sb.toString();
+    }
+
+    /**
+     * Đếm ngược đến Tết Nguyên Đán tiếp theo.
+     */
+    public static EventInfo countdownTet() {
+        Calendar cal = Calendar.getInstance();
+        for (int offset = 0; offset <= 385; offset++) {
+            Calendar target = Calendar.getInstance();
+            target.add(Calendar.DAY_OF_YEAR, offset);
+            int td = target.get(Calendar.DAY_OF_MONTH);
+            int tm = target.get(Calendar.MONTH) + 1;
+            int ty = target.get(Calendar.YEAR);
+
+            int[] lunar = Lunar.fromSolar(td, tm, ty, 7.0);
+            if (lunar[0] == 1 && lunar[1] == 1) { // Mùng 1 Tết
+                String yearCanChi = getYearCanChi(lunar[2]);
+                String title = "Tết Nguyên Đán (" + yearCanChi + ")";
+                return new EventInfo(title, offset);
+            }
+        }
+        return new EventInfo("Tết Nguyên Đán", 0);
+    }
+
+    /**
+     * Đếm ngược đến ngày Rằm (ngày 15) hoặc Mùng 1 âm lịch gần nhất.
+     */
+    public static EventInfo countdownNearestLunarPhase() {
+        Calendar cal = Calendar.getInstance();
+        int curYear = cal.get(Calendar.YEAR);
+        int curMonth = cal.get(Calendar.MONTH) + 1;
+        int curDay = cal.get(Calendar.DAY_OF_MONTH);
+
+        int[] todayLunar = Lunar.fromSolar(curDay, curMonth, curYear, 7.0);
+        int lunarDay = todayLunar[0];
+        int lunarMonth = todayLunar[1];
+
+        if (lunarDay == 1) return new EventInfo("Mùng 1 tháng " + lunarMonth + " Âm lịch", 0);
+        if (lunarDay == 15) return new EventInfo("Ngày Rằm tháng " + lunarMonth + " Âm lịch", 0);
+
+        for (int offset = 1; offset <= 30; offset++) {
+            Calendar target = Calendar.getInstance();
+            target.add(Calendar.DAY_OF_YEAR, offset);
+            int td = target.get(Calendar.DAY_OF_MONTH);
+            int tm = target.get(Calendar.MONTH) + 1;
+            int ty = target.get(Calendar.YEAR);
+
+            int[] lunar = Lunar.fromSolar(td, tm, ty, 7.0);
+            if (lunar[0] == 15) {
+                return new EventInfo("ngày Rằm tháng " + lunar[1] + " Âm lịch", offset);
+            }
+            if (lunar[0] == 1) {
+                return new EventInfo("Mùng 1 tháng " + lunar[1] + " Âm lịch", offset);
+            }
+        }
+        return new EventInfo("ngày Rằm", 1);
+    }
+
+    /**
+     * Sự kiện gần nhất (Tết, Rằm, Mùng 1 hoặc ngày lễ âm/dương).
+     */
+    public static EventInfo getNearestEvent() {
+        EventInfo tet = countdownTet();
+        if (tet.daysRemaining <= 60) {
+            return tet;
+        }
+
+        Calendar cal = Calendar.getInstance();
+        for (int offset = 0; offset <= 15; offset++) {
+            Calendar target = Calendar.getInstance();
+            target.add(Calendar.DAY_OF_YEAR, offset);
+            int td = target.get(Calendar.DAY_OF_MONTH);
+            int tm = target.get(Calendar.MONTH) + 1;
+            int ty = target.get(Calendar.YEAR);
+
+            String solarHoliday = getSolarHoliday(td, tm);
+            if (solarHoliday != null) {
+                return new EventInfo(solarHoliday, offset);
+            }
+
+            int[] lunar = Lunar.fromSolar(td, tm, ty, 7.0);
+            String lunarHoliday = getLunarHoliday(lunar[0], lunar[1]);
+            if (lunarHoliday != null) {
+                return new EventInfo(lunarHoliday, offset);
+            }
+        }
+
+        return countdownNearestLunarPhase();
+    }
+
+    private static String getSolarHoliday(int d, int m) {
+        if (d == 1 && m == 1) return "Tết Dương lịch";
+        if (d == 14 && m == 2) return "Lễ Tình nhân";
+        if (d == 8 && m == 3) return "Quốc tế Phụ nữ";
+        if (d == 30 && m == 4) return "Ngày Thống nhất";
+        if (d == 1 && m == 5) return "Quốc tế Lao động";
+        if (d == 19 && m == 5) return "Sinh nhật Bác Hồ";
+        if (d == 1 && m == 6) return "Quốc tế Thiếu nhi";
+        if (d == 28 && m == 6) return "Ngày Gia đình Việt Nam";
+        if (d == 27 && m == 7) return "Thương binh Liệt sĩ";
+        if (d == 2 && m == 9) return "Quốc khánh 2/9";
+        if (d == 20 && m == 10) return "Phụ nữ Việt Nam";
+        if (d == 31 && m == 10) return "Halloween";
+        if (d == 20 && m == 11) return "Nhà giáo Việt Nam";
+        if (d == 22 && m == 12) return "Quân đội Nhân dân";
+        if (d == 24 && m == 12) return "Đêm Giáng sinh";
+        if (d == 25 && m == 12) return "Lễ Giáng sinh";
+        return null;
+    }
+
+    private static String getLunarHoliday(int d, int m) {
+        if (d == 1 && m == 1) return "Mùng 1 Tết Nguyên Đán";
+        if (d == 2 && m == 1) return "Mùng 2 Tết Nguyên Đán";
+        if (d == 3 && m == 1) return "Mùng 3 Tết Nguyên Đán";
+        if (d == 15 && m == 1) return "Rằm tháng Giêng";
+        if (d == 3 && m == 3) return "Tết Hàn thực";
+        if (d == 10 && m == 3) return "Giỗ Tổ Hùng Vương";
+        if (d == 15 && m == 4) return "Đại lễ Phật Đản";
+        if (d == 5 && m == 5) return "Tết Đoan Ngọ";
+        if (d == 7 && m == 7) return "Lễ Thất tịch";
+        if (d == 15 && m == 7) return "Lễ Vu Lan";
+        if (d == 15 && m == 8) return "Tết Trung Thu";
+        if (d == 23 && m == 12) return "Ông Công Ông Táo";
+        return null;
+    }
+
+    private static String getYearCanChi(int year) {
+        String[] stems = {"Giáp", "Ất", "Bính", "Đinh", "Mậu", "Kỷ", "Canh", "Tân", "Nhâm", "Quý"};
+        String[] branches = {"Tý", "Sửu", "Dần", "Mão", "Thìn", "Tỵ", "Ngọ", "Mùi", "Thân", "Dậu", "Tuất", "Hợi"};
+        int stemIdx = Math.floorMod(year + 6, 10);
+        int branchIdx = Math.floorMod(year + 8, 12);
+        return stems[stemIdx] + " " + branches[branchIdx];
+    }
+}
