+    def __init__(self, replies):
+        handshake = packet(constants.CNXN, constants.VERSION, constants.MAX_ADB_DATA, b"device::\0")
+        self.incoming = bytearray(handshake + replies)
+        self.writes = []
+        self.eof_reads = 0
+        self.closed = False
+
+    def connect(self, transport_timeout_s):
+        self.closed = False
+
+    def close(self):
