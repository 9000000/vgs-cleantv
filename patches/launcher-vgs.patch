diff --git a/addons/sleep-timer/app/src/main/java/io/github/luyzfernando08/sleeptimer/BedtimeActivity.java b/addons/sleep-timer/app/src/main/java/io/github/luyzfernando08/sleeptimer/BedtimeActivity.java
