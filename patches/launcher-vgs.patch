new file mode 100644
index 00000000..9b2fd8e3
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/LinkTiles.java
@@ -0,0 +1,152 @@
+package com.gathin.tvhome;
+
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.ColorFilter;
+import android.graphics.LinearGradient;
+import android.graphics.Paint;
+import android.graphics.PixelFormat;
+import android.graphics.Rect;
+import android.graphics.Shader;
+import android.graphics.Typeface;
+import android.graphics.drawable.Drawable;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.InputStream;
+import java.util.ArrayList;
+import java.util.List;
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+/**
+ * CleanTV/VGS: tiles that open a link in another app instead of the app's start screen, e.g. a TV channel straight
+ * in VTVgo (feedback 23/10/2026: "lôi các kênh VTV1, VTV2, VTV3 ra màn chính" for parents). config.json
+ * link_tiles holds "Label|package|uri|#colour" entries. Each tile behaves as an app whose package is
+ * {@link #PREFIX} plus the label in lower case, so dock_apps, the saved order and Remove from Home all work on it. A
+ * kenh-<that suffix>.jpg beside config.json (the channel's logo card) replaces the drawn label.
+ */
+final class LinkTiles {
+    static final String PREFIX = "vgs.kenh.";
+    private static final int MAX = 12;
+
+    static final class Link {
+        final String label, target, uri, pkg;
+        final int color;
+        /** The tile's picture (kenh-<label>.jpg beside config.json, sent by CleanTV), or null to draw the label. */
+        Drawable picture;
+
+        Link(String label, String target, String uri, int color) {
+            this.label = label;
+            this.target = target;
+            this.uri = uri;
+            this.color = color;
+            this.pkg = PREFIX + label.toLowerCase(java.util.Locale.ROOT).replaceAll("[^a-z0-9]", "");
+        }
+    }
+
+    private LinkTiles() {
+    }
+
+    /** The link_tiles entries whose target app is installed; bad entries are skipped. */
+    static List<Link> load(Context ctx) {
+        List<Link> out = new ArrayList<>();
+        File dir = Config.dir(ctx);
+        File f = dir != null ? new File(dir, Config.FILE_NAME) : null;
+        if (f == null || !f.isFile() || f.length() > 64 * 1024) return out;
+        try (InputStream in = new FileInputStream(f)) {
+            JSONArray a = new JSONObject(new String(Weather.readAll(in), "UTF-8")).optJSONArray("link_tiles");
+            if (a == null) return out;
+            for (int i = 0; i < a.length() && out.size() < MAX; i++) {
+                String[] p = a.optString(i, "").split("\\|", -1);
+                if (p.length < 3) continue;
+                String label = p[0].trim(), target = p[1].trim(), uri = p[2].trim();
+                if (label.isEmpty() || label.length() > 24 || target.isEmpty() || !uri.contains(":")) continue;
+                int color = 0xFF3A3A44;
+                if (p.length > 3) {
+                    try {
+                        color = Color.parseColor(p[3].trim());
+                    } catch (IllegalArgumentException ignored) {
+                    }
+                }
+                try {
+                    ctx.getPackageManager().getPackageInfo(target, 0);
+                } catch (Exception notInstalled) {
+                    continue;
+                }
+                Link l = new Link(label, target, uri, color | 0xFF000000);
+                File pic = new File(dir, "kenh-" + l.pkg.substring(PREFIX.length()) + ".jpg");
+                if (pic.isFile() && pic.length() < 512 * 1024) {
+                    android.graphics.Bitmap b = android.graphics.BitmapFactory.decodeFile(pic.getPath());
+                    if (b != null) l.picture = new android.graphics.drawable.BitmapDrawable(ctx.getResources(), b);
+                }
+                out.add(l);
+            }
+        } catch (Exception ignored) {
+        }
+        return out;
+    }
+
+    /** The tile face: the label in large bold type on a gradient of the link's colour, filling the whole card. */
+    static final class Face extends Drawable {
+        private final String text;
+        private final int color;
+        private final Paint fill = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final Paint type = new Paint(Paint.ANTI_ALIAS_FLAG);
+
+        Face(String text, int color) {
+            this.text = text;
+            this.color = color;
+            type.setColor(Color.WHITE);
+            type.setTypeface(Typeface.create(Typeface.DEFAULT, Typeface.BOLD));
+            type.setTextAlign(Paint.Align.CENTER);
+        }
+
+        @Override
+        protected void onBoundsChange(Rect b) {
+            float[] hsv = new float[3];
+            Color.colorToHSV(color, hsv);
+            hsv[2] *= 0.62f;
+            fill.setShader(new LinearGradient(0, b.top, 0, b.bottom, color, Color.HSVToColor(hsv), Shader.TileMode.CLAMP));
+            float size = b.height() * 0.38f;
+            type.setTextSize(size);
+            // Long labels shrink to fit the card's width with a margin either side.
+            float w = type.measureText(text);
+            if (w > b.width() * 0.84f) type.setTextSize(size * b.width() * 0.84f / w);
+        }
+
+        @Override
+        public void draw(Canvas c) {
+            Rect b = getBounds();
+            c.drawRect(b, fill);
+            Paint.FontMetrics m = type.getFontMetrics();
+            c.drawText(text, b.exactCenterX(), b.exactCenterY() - (m.ascent + m.descent) / 2f, type);
+        }
+
+        @Override
+        public void setAlpha(int alpha) {
+            fill.setAlpha(alpha);
+            type.setAlpha(alpha);
+        }
+
+        @Override
+        public void setColorFilter(ColorFilter cf) {
+            fill.setColorFilter(cf);
+        }
+
+        @Override
+        public int getOpacity() {
+            return PixelFormat.OPAQUE;
+        }
+
+        @Override
+        public int getIntrinsicWidth() {
+            return 320;
+        }
+
+        @Override
+        public int getIntrinsicHeight() {
+            return 180;
+        }
+    }
+}
