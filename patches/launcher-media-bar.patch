diff --git a/launcher/app/src/main/java/com/gathin/tvhome/MediaBarManager.java b/launcher/app/src/main/java/com/gathin/tvhome/MediaBarManager.java
new file mode 100644
index 00000000..dc521672
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/MediaBarManager.java
@@ -0,0 +1,251 @@
+package com.gathin.tvhome;
+
+import android.content.ComponentName;
+import android.content.Context;
+import android.media.MediaMetadata;
+import android.media.session.MediaController;
+import android.media.session.MediaSessionManager;
+import android.media.session.PlaybackState;
+import android.os.Handler;
+import android.os.Looper;
+import android.text.TextUtils;
+import android.util.Log;
+import android.view.View;
+import android.widget.ImageView;
+import android.widget.TextView;
+
+import java.util.List;
+
+/**
+ * Manages the "Now Playing" Mini Player bar on CleanTV Home screen.
+ * Listens to active MediaSessions from background music apps (Spotify, YouTube, etc.)
+ */
+final class MediaBarManager {
+    private static final String TAG = "TvHome.MediaBar";
+
+    private final Context context;
+    private final View mediaPill;
+    private final TextView textTitle;
+    private final ImageView iconPlayPause;
+    private final Handler mainHandler = new Handler(Looper.getMainLooper());
+
+    private MediaSessionManager sessionManager;
+    private MediaController activeController;
+    private ComponentName listenerComponent;
+
+    private final MediaController.Callback controllerCallback = new MediaController.Callback() {
+        @Override
+        public void onPlaybackStateChanged(PlaybackState state) {
+            mainHandler.post(() -> updateState(state));
+        }
+
+        @Override
+        public void onMetadataChanged(MediaMetadata metadata) {
+            mainHandler.post(() -> updateMetadata(metadata));
+        }
+
+        @Override
+        public void onSessionDestroyed() {
+            mainHandler.post(() -> {
+                activeController = null;
+                refreshSessions();
+            });
+        }
+    };
+
+    private final MediaSessionManager.OnActiveSessionsChangedListener sessionsListener =
+            controllers -> mainHandler.post(this::refreshSessions);
+
+    MediaBarManager(Context context, View mediaPill, TextView textTitle, ImageView iconPlayPause) {
+        this.context = context;
+        this.mediaPill = mediaPill;
+        this.textTitle = textTitle;
+        this.iconPlayPause = iconPlayPause;
+
+        this.listenerComponent = MediaNotificationListener.getComponentName(context);
+        this.sessionManager = (MediaSessionManager) context.getSystemService(Context.MEDIA_SESSION_SERVICE);
+
+        setupControls();
+    }
+
+    private void setupControls() {
+        if (mediaPill == null) return;
+
+        // Click to toggle Play / Pause
+        mediaPill.setOnClickListener(v -> {
+            if (activeController == null) return;
+            PlaybackState state = activeController.getPlaybackState();
+            if (state == null) return;
+            MediaController.TransportControls controls = activeController.getTransportControls();
+            if (controls == null) return;
+
+            if (state.getState() == PlaybackState.STATE_PLAYING) {
+                controls.pause();
+            } else {
+                controls.play();
+            }
+        });
+
+        // Long press to skip to next track
+        mediaPill.setOnLongClickListener(v -> {
+            if (activeController == null) return false;
+            MediaController.TransportControls controls = activeController.getTransportControls();
+            if (controls != null) {
+                controls.skipToNext();
+                return true;
+            }
+            return false;
+        });
+    }
+
+    void start() {
+        if (sessionManager == null) return;
+        try {
+            sessionManager.addOnActiveSessionsChangedListener(sessionsListener, listenerComponent);
+            refreshSessions();
+        } catch (SecurityException e) {
+            // Notification access not yet granted; try with null for system app fallback
+            try {
+                sessionManager.addOnActiveSessionsChangedListener(sessionsListener, null);
+                refreshSessions();
+            } catch (Exception ex) {
+                Log.d(TAG, "MediaSession access requires notification listener or system privileges: " + ex.getMessage());
+            }
+        } catch (Exception e) {
+            Log.w(TAG, "Failed to start MediaBarManager: " + e.getMessage());
+        }
+    }
+
+    void stop() {
+        if (sessionManager != null) {
+            try {
+                sessionManager.removeOnActiveSessionsChangedListener(sessionsListener);
+            } catch (Exception ignored) {}
+        }
+        if (activeController != null) {
+            try {
+                activeController.unregisterCallback(controllerCallback);
+            } catch (Exception ignored) {}
+            activeController = null;
+        }
+    }
+
+    void refreshSessions() {
+        if (sessionManager == null) return;
+
+        List<MediaController> controllers = null;
+        try {
+            controllers = sessionManager.getActiveSessions(listenerComponent);
+        } catch (SecurityException e) {
+            try {
+                controllers = sessionManager.getActiveSessions(null);
+            } catch (Exception ignored) {}
+        } catch (Exception e) {
+            Log.d(TAG, "Error getting active sessions: " + e.getMessage());
+        }
+
+        MediaController bestController = null;
+        if (controllers != null && !controllers.isEmpty()) {
+            // Prefer a playing controller first
+            for (MediaController c : controllers) {
+                PlaybackState s = c.getPlaybackState();
+                if (s != null && s.getState() == PlaybackState.STATE_PLAYING) {
+                    bestController = c;
+                    break;
+                }
+            }
+            if (bestController == null) {
+                // Otherwise take the first controller with valid metadata
+                for (MediaController c : controllers) {
+                    if (c.getMetadata() != null) {
+                        bestController = c;
+                        break;
+                    }
+                }
+            }
+        }
+
+        if (bestController != activeController) {
+            if (activeController != null) {
+                try {
+                    activeController.unregisterCallback(controllerCallback);
+                } catch (Exception ignored) {}
+            }
+            activeController = bestController;
+            if (activeController != null) {
+                activeController.registerCallback(controllerCallback);
+            }
+        }
+
+        if (activeController != null) {
+            updateMetadata(activeController.getMetadata());
+            updateState(activeController.getPlaybackState());
+        } else {
+            hidePill();
+        }
+    }
+
+    private void updateMetadata(MediaMetadata metadata) {
+        if (metadata == null) {
+            if (activeController == null) hidePill();
+            return;
+        }
+
+        String title = metadata.getString(MediaMetadata.METADATA_KEY_TITLE);
+        String artist = metadata.getString(MediaMetadata.METADATA_KEY_ARTIST);
+
+        if (TextUtils.isEmpty(title)) {
+            title = metadata.getString(MediaMetadata.METADATA_KEY_DISPLAY_TITLE);
+        }
+
+        if (TextUtils.isEmpty(title)) {
+            hidePill();
+            return;
+        }
+
+        StringBuilder sb = new StringBuilder(title);
+        if (!TextUtils.isEmpty(artist)) {
+            sb.append(" • ").append(artist);
+        }
+
+        if (textTitle != null) {
+            textTitle.setText(sb.toString());
+            textTitle.setSelected(true); // Enable marquee scrolling if text overflows
+        }
+
+        showPill();
+    }
+
+    private void updateState(PlaybackState state) {
+        if (state == null) return;
+
+        int playState = state.getState();
+        boolean isPlaying = (playState == PlaybackState.STATE_PLAYING || playState == PlaybackState.STATE_BUFFERING);
+
+        if (iconPlayPause != null) {
+            iconPlayPause.setImageResource(isPlaying ? R.drawable.ic_pause : R.drawable.ic_play);
+        }
+
+        if (playState == PlaybackState.STATE_STOPPED || playState == PlaybackState.STATE_NONE) {
+            hidePill();
+        } else {
+            showPill();
+        }
+    }
+
+    private void showPill() {
+        if (mediaPill != null && mediaPill.getVisibility() != View.VISIBLE) {
+            mediaPill.setVisibility(View.VISIBLE);
+            mediaPill.setAlpha(0f);
+            mediaPill.animate().alpha(1f).setDuration(250).start();
+        }
+    }
+
+    private void hidePill() {
+        if (mediaPill != null && mediaPill.getVisibility() == View.VISIBLE) {
+            mediaPill.animate().alpha(0f).setDuration(200).withEndAction(() -> {
+                mediaPill.setVisibility(View.GONE);
+            }).start();
+        }
+    }
+}
