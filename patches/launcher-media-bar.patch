@@ -0,0 +1,14 @@
+package com.gathin.tvhome;
+
+import android.content.ComponentName;
+import android.content.Context;
+import android.service.notification.NotificationListenerService;
+
+/**
+ * Lightweight NotificationListenerService to authorize MediaSessionManager access on Android TV.
+ */
+public final class MediaNotificationListener extends NotificationListenerService {
+    public static ComponentName getComponentName(Context context) {
+        return new ComponentName(context, MediaNotificationListener.class);
+    }
+}
